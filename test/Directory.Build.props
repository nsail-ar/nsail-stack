<Project>

	<!-- Nothing under test/ is a package, including
	     the helper projects that carry no test SDK of their own. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

</Project>
