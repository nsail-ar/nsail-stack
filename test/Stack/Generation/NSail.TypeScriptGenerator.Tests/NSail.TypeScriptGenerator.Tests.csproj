<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- The fixtures are an Sdk's sources, compiled by the test the way the tool compiles a real
	     one, never by this project: a [Generated] holder has no body without the generator. -->
	<ItemGroup>
		<Compile Remove="Sources\**" />
		<None Include="Sources\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="8.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\src\Stack\Generation\NSail.TypeScriptGenerator\NSail.TypeScriptGenerator.csproj" />
		<ProjectReference Include="..\..\..\..\src\Stack\Generation\NSail.SourceGeneration.Annotations\NSail.SourceGeneration.Annotations.csproj" />
		<ProjectReference Include="..\..\..\..\src\Stack\Messaging\NSail.Messaging\NSail.Messaging.csproj" />
		<ProjectReference Include="..\..\..\..\src\Stack\Messaging\NSail.Messaging.Annotations\NSail.Messaging.Annotations.csproj" />
		<ProjectReference Include="..\..\..\..\src\Stack\Messaging\NSail.Messaging.Runtime\NSail.Messaging.Runtime.csproj" />
		<ProjectReference Include="..\..\..\..\src\Stack\Types\NSail.Types\NSail.Types.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
