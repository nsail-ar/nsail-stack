@using MudBlazor
@using NSail.Components

@* The menu opens into a popover, which is a portal: without a provider in the tree there is
   no open menu to assert anything about. *@
<MudPopoverProvider />

<NsMenu Icon="@NsIcons.More" Label="Session" Disabled="Locked">
    <NsMenuBlock>
        <span class="probe-identity">Amina</span>
    </NsMenuBlock>
    <NsMenuItem Action="@Switch" Label="Alpha" Selected="true" />
    <NsMenuItem Action="@Switch" Label="Beta" Selected="false" />
    <NsMenuDivider />
    <NsMenuItem Action="@Profile" />
    <NsMenuItem Action="@Report" Selected="ReportSelected" />
    <NsMenuItem Action="@Refused" />
    <NsMenuItem Action="@Unavailable" />
    @if (Extra is not null)
    {
        <NsMenuItem Action="@Extra" />
    }
    <NsMenu Label="Change organization">
        <NsMenuItem Action="@Switch" Label="Gamma" Selected="false" />
    </NsMenu>
    <MenuBodyProbe OnRan="OnSwitch" />
    <NsMenuBlock>
        <span class="probe-version">v1.2.3</span>
    </NsMenuBlock>
</NsMenu>

@code {

    [Parameter]
    public EventCallback OnSwitch { get; set; }

    /// <summary>The trigger offered and not yet answerable — a menu whose list has nothing to
    /// say until the screen around it is further filled.</summary>
    [Parameter]
    public bool Locked { get; set; }

    ActionItem Switch => new() { Name = "SelectOrganization", OnClick = () => OnSwitch.InvokeAsync() };

    /// <summary>The address row standing as one of a single choice, unset as a verb.</summary>
    [Parameter]
    public bool? ReportSelected { get; set; }

    /// <summary>One more row a case needs and the rest of the menu does not.</summary>
    [Parameter]
    public ActionItem? Extra { get; set; }

    ActionItem Report => new() { Name = "Report", Icon = NsIcons.Print, Url = "/files/report.pdf", Target = Surfaces.Blank, Writes = false };

    ActionItem Refused => new() { Name = "Refused", Url = "javascript:alert(1)", Target = Surfaces.Blank, Writes = false };

    ActionItem Unavailable => new() { Name = "Unavailable", Url = "/files/later.pdf", Target = Surfaces.Blank, Disabled = true, Writes = false };

    ActionItem Profile => new() { Name = "Profile", PageType = typeof(ProbeAdminPage), Target = Surfaces.Main };
}
