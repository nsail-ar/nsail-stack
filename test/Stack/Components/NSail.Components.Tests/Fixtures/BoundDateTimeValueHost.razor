@using MudBlazor

@* DateTimeValueHost's twin that holds the value the way a page does, so what the field writes
   comes back down as its parameter — the round trip a clock pick has to survive. *@
<MudPopoverProvider />

<NsDateTimeField TValue="DateTime" @bind-Value="Value" />

@code {

    [Parameter]
    public DateTime Value { get; set; }
}
