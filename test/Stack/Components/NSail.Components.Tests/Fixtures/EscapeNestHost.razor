@namespace NSail.Components.Tests.Fixtures

@using MudBlazor
@using NSail.Components

@* One thing that answers Escape, inside the wrapper a routed surface and the companion region
   take Escape from. Closes stands for the companion region; Surface, when given, for a routed
   non-main surface whose own Close() is the way out. *@
<MudPopoverProvider />

<CascadingValue Value="Surface" IsFixed="true">
    <NsCloseOnEscape Closes="Closes">
        @switch (Inner)
        {
            case "dropdown":
                <NsDropdown @bind-Open="DropdownOpen">
                    <Anchor><input class="field" /></Anchor>
                    <ChildContent><div class="row">one</div></ChildContent>
                </NsDropdown>
                break;
            case "help":
                <NsHelp Key="Common.Help" />
                break;
            case "hint":
                <NsHint Icon="@NsIcons.Warning" Text="Solo quedan 2" />
                break;
            case "expander":
                <NsExpander>
                    <Summary><span class="strip">Total</span></Summary>
                    <Detail><input class="working" /></Detail>
                </NsExpander>
                break;
            case "lookup":
                @* Browsed rows on focus, or — Lazy, with a quick add — the entries alone that a term
                   nothing matches leaves. *@
                <NsAutocomplete TItem="SelectRef" TValue="Guid"
                                Label="Médico"
                                Lazy="LookupEntries"
                                Items="Rows"
                                ItemValue="@(item => item.Id)"
                                ItemText="@(item => item.DisplayName)"
                                @bind-Value="Picked"
                                OnQuickAdd="@(LookupEntries ? QuickAdd : default)" />
                break;
            case "menu":
                <NsMenu Icon="@NsIcons.More" Label="Session">
                    <NsMenuItem Action="@Item" Label="Alpha" Selected="false" />
                </NsMenu>
                break;
            default:
                <input class="plain" />
                break;
        }
    </NsCloseOnEscape>
</CascadingValue>

@code {

    /// <summary>dropdown, help, hint, expander, menu, lookup, or anything else for a bare field.</summary>
    [Parameter]
    public string Inner { get; set; } = string.Empty;

    [Parameter]
    public bool DropdownOpen { get; set; }

    [Parameter]
    public EventCallback Closes { get; set; }

    [Parameter]
    public SurfaceContext? Surface { get; set; }

    /// <summary>For the lookup: true for a list of entries alone, false for one of rows.</summary>
    [Parameter]
    public bool LookupEntries { get; set; }

    public Guid Picked { get; set; }

    static readonly SelectRef[] Rows =
    [
        new(Guid.Parse("11111111-1111-1111-1111-111111111111"), "Gómez"),
        new(Guid.Parse("22222222-2222-2222-2222-222222222222"), "Gómora"),
    ];

    EventCallback<QuickAddEventArgs<SelectRef>> QuickAdd => EventCallback.Factory.Create<QuickAddEventArgs<SelectRef>>(this, _ => { });

    ActionItem Item => new() { Name = "Alpha", OnClick = () => Task.CompletedTask };
}
