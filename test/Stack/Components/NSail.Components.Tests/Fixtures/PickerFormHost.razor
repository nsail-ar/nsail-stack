@namespace NSail.Components.Tests.Fixtures

@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using NSail.Components

@* The two controls a form holds side by side: a bare picker and a real lookup, both under
   whatever the form says about being written to. The session cascades above them because the
   lookup's create entry is gated on the create page, and the popover provider is here because
   the dropdown renders into a portal. *@
<MudPopoverProvider />

<CascadingAuthenticationState>
    <NsForm TModel="FieldProbeModel" Model="_model" ReadOnly="ReadOnly" Disabled="Disabled" Untracked>
        <PickerProbe />
        <SelectLookup Create Label="Taller" @bind-Value="context.Choice" />
    </NsForm>
</CascadingAuthenticationState>

@code {

    readonly FieldProbeModel _model = new();

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

}
