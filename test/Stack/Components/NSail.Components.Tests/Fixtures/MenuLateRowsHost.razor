@using MudBlazor
@using NSail.Components

@* A menu with a face of its own whose rows arrive after it opened, the shape of an offer's menu
   whose search answers while somebody types. *@
<MudPopoverProvider />

<NsMenu Content="@Face" Label="Link code" Beside="true">
    <NsMenuBlock>
        <input class="probe-search" />
    </NsMenuBlock>
    @if (Answered)
    {
        <NsMenuItem Action="@Pick" Label="Unidad" />
        <NsMenuItem Action="@Pick" Label="Caja" />
    }
</NsMenu>

@code {

    [Parameter]
    public bool Answered { get; set; }

    RenderFragment Face => @<span class="probe-face">sku-1</span>;

    ActionItem Pick => new() { Name = "TeachCode", OnClick = () => Task.CompletedTask };
}
