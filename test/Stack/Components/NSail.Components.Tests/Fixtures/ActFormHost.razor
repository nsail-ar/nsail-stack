@namespace NSail.Components.Tests.Fixtures

@using MudBlazor
@using NSail.Components
@using NSail.Icons
@using NSail.Testing.Models

@inherits NsPartial

@* The two mouths an ActionItem has, both inside one form: the acts a kit hand-draws for
   itself (LocationsEditor's Edit, ChannelsEditor's Contact) and the toolbar an outlet hands
   its verbs to. The toolbar's cap is one, so what survives the form's word is what decides
   whether a kebab opens at all. *@
<MudPopoverProvider />

<NsForm TModel="TestModel" Model="_document" ReadOnly="ReadOnly" Disabled="Disabled" Untracked>
    <NsAction Action="@GetAction(Rename, NsIcons.Edit)" />
    <NsAction Action="@GetAction(Probe, NsIcons.Sync, writes: false)" />
    <NsActionToolbar Leading="Verbs()" Constant="Ficha()" MaxVisible="1" />
</NsForm>

@code {

    readonly TestModel _document = new();

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    IReadOnlyList<ActionItem> Verbs()
    {
        return [GetAction(Archive, NsIcons.Delete), GetAction(Contact, NsIcons.Send, writes: false)];
    }

    static ActionItem Ficha()
    {
        return GetLink<ProbeOtherPage>(NsIcons.Search);
    }

    void Rename()
    {
    }

    void Probe()
    {
    }

    void Archive()
    {
    }

    void Contact()
    {
    }
}
