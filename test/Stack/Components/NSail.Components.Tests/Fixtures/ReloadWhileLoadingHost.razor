@using MudBlazor
@using NSail.Components
@using NSail.Paging
@using NSail.Testing.Models

<MudPopoverProvider />

@* Page mode, whose pages MudTable pulls through ServerData. The first query is held open by the
   gate so a second one can arrive while it runs — a search typed while a page is still loading. *@
<NsTable TRow="TestModel" Rows="Page" OnQuery="Query" Mode="NsTableMode.Page" @ref="_table">
    <HeaderContent>
        <NsTh For="() => context.Name" />
    </HeaderContent>
    <RowTemplate Context="row">
        <NsTd For="() => row.Name">@row.Name</NsTd>
    </RowTemplate>
</NsTable>

@code {

    NsTable<TestModel>? _table;

    [Parameter, EditorRequired]
    public TaskCompletionSource Gate { get; set; } = default!;

    public int Queries { get; private set; }

    public NsTable<TestModel> Table => _table!;

    DataPage<TestModel> Page { get; set; } = DataPage<TestModel>.Empty();

    Task Query(QueryEventArgs args)
    {
        Queries++;

        return Queries == 1 ? Gate.Task : Task.CompletedTask;
    }
}
