@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@* An NsHelp standing inside something that also answers Escape, as a field in a routed
   surface does: Escapes counts the keys that reach the outer element. *@
<MudPopoverProvider />

<div class="surface" @onkeydown="OnKeyDown">
    <NsHelp Key="@Key" />
</div>

@code {

    [Parameter]
    public string Key { get; set; } = string.Empty;

    public int Escapes { get; private set; }

    void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Escapes++;
        }
    }
}
