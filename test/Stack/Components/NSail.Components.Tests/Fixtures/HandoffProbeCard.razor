@inherits NsPartial

<p id="figure">@_answer.Count</p>

@code {

    ProbeAnswer _answer = new();

    [Parameter]
    public Guid? Subject { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _answer = await Handoff(new ProbeRead { SubjectId = Subject ?? Guid.Empty }, Subject);
    }
}
