@namespace NSail.Components.Tests.Fixtures

@using MudBlazor
@using NSail.Components
@using NSail.Paging

<MudPopoverProvider />

@{
    RenderFragment<ServiceRefusalRow> editor = row =>
        @<text>
            <NsTd For="() => row.Number">
                <NsTextField @bind-Value="row.Number" Label="Line" />
            </NsTd>
        </text>;
}

<NsForm TModel="ServiceRefusalModel" Model="Model" OnSubmit="HandleSubmit" Context="document">
    <NsTextField @bind-Value="document.Number" Label="Number" />

    <NsTable TRow="ServiceRefusalRow" Rows="Lines" Title="Líneas" RowEditor="editor">
        <HeaderContent Context="header">
            <NsTh For="() => header.Number" />
        </HeaderContent>
        <RowTemplate Context="row">
            <NsTd For="() => row.Number">@row.Number</NsTd>
        </RowTemplate>
    </NsTable>

    <NsListEditor TItem="ServiceRefusalRow" Items="Model.Items" Title="Ítems">
        <ItemTemplate Context="item">
            <span class="item-number">@item.Number</span>
        </ItemTemplate>
        <ItemEditor Context="item">
            <NsTextField @bind-Value="item.Number" Label="Item" />
        </ItemEditor>
    </NsListEditor>
</NsForm>

@code {

    [Parameter, EditorRequired]
    public ServiceRefusalModel Model { get; set; } = default!;

    public int Submits { get; private set; }

    DataPage<ServiceRefusalRow> Lines => DataPage<ServiceRefusalRow>.From(Model.Lines);

    void HandleSubmit(SubmitEventArgs<ServiceRefusalModel> args)
    {
        Submits++;
    }
}
