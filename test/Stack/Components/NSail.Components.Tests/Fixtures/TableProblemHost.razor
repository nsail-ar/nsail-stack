@namespace NSail.Components.Tests.Fixtures

@using MudBlazor
@using NSail.Components
@using NSail.Paging
@using NSail.Problems
@using NSail.Testing.Models

@* The grid's own row editor inside a document, with no rule of the screen's own to refuse a
   row: the submit settles the row left open before it validates (IFormRows), so the row is
   closed by the time anything is sent and a server answer naming it finds no field of its own
   on screen. *@
<MudPopoverProvider />

@{
    RenderFragment<AddressRow> editor = row =>
        @<text>
            <NsTd For="() => row.Street">
                <NsTextField @bind-Value="row.Street" Label="" />
            </NsTd>
        </text>;
}

<NsForm TModel="CollectionProblemModel" Model="Model" OnSubmit="HandleSubmit">
    <NsTable TRow="AddressRow" Rows="Rows" Title="Direcciones" RowEditor="editor">
        <HeaderContent Context="header">
            <NsTh For="() => header.Street" />
        </HeaderContent>
        <RowTemplate Context="row">
            <NsTd For="() => row.Street">@row.Street</NsTd>
        </RowTemplate>
    </NsTable>
</NsForm>

@code {

    [Parameter, EditorRequired]
    public CollectionProblemModel Model { get; set; } = default!;

    [Parameter]
    public Problem? Problem { get; set; }

    DataPage<AddressRow> Rows => DataPage<AddressRow>.From(Model.Addresses);

    void HandleSubmit(SubmitEventArgs<CollectionProblemModel> args)
    {
        args.Problem = Problem;
    }
}
