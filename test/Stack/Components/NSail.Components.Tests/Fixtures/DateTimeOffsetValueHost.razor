@using MudBlazor

@* The field renders popover-bearing pickers, so the provider has to be in the
   tree for the field to render at all — the SelectValueHost rule, same reason. *@
<MudPopoverProvider />

<NsDateTimeField TValue="DateTimeOffset" Value="Value" ValueChanged="ValueChanged" />

@code {

    [Parameter]
    public DateTimeOffset Value { get; set; }

    [Parameter]
    public EventCallback<DateTimeOffset> ValueChanged { get; set; }
}
