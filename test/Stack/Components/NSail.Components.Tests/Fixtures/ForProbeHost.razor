@namespace NSail.Components.Tests.Fixtures

@using NSail.Components
@using MudBlazor

@* Instrumentation: the same arrival question FieldProbeHost asks, with the binding stated as
   an explicit For beside a one-way Value/ValueChanged pair — the shape every editor written
   against a shared model uses (PartyIdentityEditor). The model arrives already filled and
   nothing is ever typed, so whatever reports HasChanges raised a field notification nobody
   caused. The @@bind cases ride along as the control: same field, same preset, no For. *@
<MudPopoverProvider />

<CascadingValue Value="RouteTable">
    <NsSurfaceContext Context="surface">
        @{ _surface = surface; }
        <NsForm TModel="FieldProbeModel" Model="_model">
            @switch (Kind)
            {
                case "select-bind":
                    <NsSelect TItem="SelectOption" TValue="Guid?" @bind-Value="context.Choice"
                              Items="Options" ItemValue="o => o.Id" ItemText="o => o.Name" />
                    break;
                case "select-for":
                    <NsSelect TItem="SelectOption" TValue="Guid?" Value="context.Choice" ValueChanged="v => context.Choice = v"
                              For="() => _model.Choice"
                              Items="Options" ItemValue="o => o.Id" ItemText="o => o.Name" />
                    break;
                @* Mi Perfil's own Sexo select, verbatim (PartyIdentityEditor). *@
                case "select-for-clearable":
                    <NsSelect TItem="SelectOption" TValue="Guid?" Value="context.Choice" ValueChanged="v => context.Choice = v"
                              For="() => _model.Choice" Clearable="true" Immediate="true"
                              Items="Options" ItemValue="o => o.Id" ItemText="o => o.Name" />
                    break;
                case "text-for":
                    <NsTextField Value="context.Text" ValueChanged="v => context.Text = v" For="() => _model.Text" Immediate="true" />
                    break;
                case "text-bind":
                    <NsTextField @bind-Value="context.Text" />
                    break;
                case "checkbox-for":
                    <NsCheckBox TValue="bool" Value="context.Flag" ValueChanged="v => context.Flag = v" For="() => _model.Flag" />
                    break;
                case "numeric-for":
                    <NsNumericField TValue="int?" Value="context.Number" ValueChanged="v => context.Number = v" For="() => _model.Number" />
                    break;
                case "money-for":
                    <NsMoneyField TValue="decimal?" Value="context.Money" ValueChanged="v => context.Money = v" For="() => _model.Money" />
                    break;
                case "percent-for":
                    <NsPercentField TValue="decimal?" Value="context.Percent" ValueChanged="v => context.Percent = v" For="() => _model.Percent" />
                    break;
                case "autocomplete-for":
                    <NsAutocomplete TItem="SelectOption" TValue="Guid?" Value="context.Choice" ValueChanged="v => context.Choice = v"
                                    For="() => _model.Choice"
                                    Items="Options" ItemValue="o => o.Id" ItemText="o => o.Name" />
                    break;
                case "textarea-for":
                    <NsTextArea Value="context.Text" ValueChanged="v => context.Text = v" For="() => _model.Text" />
                    break;
            }
            <NsSubmit Class="tracked-submit" />
        </NsForm>
    </NsSurfaceContext>
</CascadingValue>

@code {

    SurfaceContext? _surface;
    FieldProbeModel _model = FieldProbeModel.Preset();

    static readonly SelectOption[] Options =
    [
        new(Guid.Parse("11111111-1111-1111-1111-111111111111"), "First"),
        new(Guid.Parse("22222222-2222-2222-2222-222222222222"), "Second"),
    ];

    [Parameter, EditorRequired]
    public RouteTable RouteTable { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Kind { get; set; } = default!;

    public SurfaceContext? Surface => _surface;
}
