@namespace NSail.Components.Tests.Fixtures

@using NSail.Components

<NsForm TModel="RequiredDerivationModel" Model="Model" OnSubmit="HandleSubmit">
    <NsTextField @bind-Value="context.Declared" Label="Declared" />
    <NsTextField @bind-Value="context.Plain" Label="Plain" />
    <NsSelect TItem="SelectRef" TValue="Guid" @bind-Value="context.Sentinel"
              Items="Items" ItemValue="i => i.Id" ItemText="i => i.DisplayName" Label="Sentinel" Required />
    <NsNumericField TValue="int" @bind-Value="context.Counted" Label="Counted" />
    <NsNumericField TValue="int" @bind-Value="context.Enforced" Label="Enforced" Required />
    <NsTextField @bind-Value="context.Conditioned" Label="Conditioned" Required="context.Conditional" />
    <NsTextField @bind-Value="context.Line.Description" Label="Line" />
</NsForm>

@code {

    static readonly SelectRef[] Items = [new(Guid.NewGuid(), "Alpha")];

    [Parameter, EditorRequired]
    public RequiredDerivationModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback Submitted { get; set; }

    async Task HandleSubmit()
    {
        await Submitted.InvokeAsync();
    }
}
