@namespace NSail.Components.Tests.Fixtures

@using MudBlazor
@using NSail.Components
@using NSail.Paging
@using NSail.Testing.Models

<MudPopoverProvider />

<NsTable TRow="TestModel" Rows="Page" Mode="NsTableMode.Page" OnQuery="Query">
    <HeaderContent>
        <NsTh For="() => context.Name" Whole="true" />
        <NsTh For="() => context.Age" />
        <NsTh>Comprobante</NsTh>
    </HeaderContent>
    <RowTemplate Context="row">
        <NsTd For="() => row.Name">@row.Name</NsTd>
        <NsTd For="() => row.Age">@row.Age</NsTd>
        <NsTd DataLabel="Comprobante" Whole="true">A-0001-00000123</NsTd>
    </RowTemplate>
</NsTable>

@code {

    readonly List<TestModel> _rows = [new TestModel { Name = "ARM-TEST-01", Age = 3 }];

    DataPage<TestModel> Page => DataPage<TestModel>.From(_rows);

    EventCallback<QueryEventArgs> Query => EventCallback.Factory.Create<QueryEventArgs>(this, () => { });
}
