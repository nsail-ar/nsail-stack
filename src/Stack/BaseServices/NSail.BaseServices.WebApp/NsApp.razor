<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />
    <link href="@Assets["_content/NSail.BaseServices.WebApp/ns.css"]" rel="stylesheet" />
    <script src="@Assets["_content/NSail.BaseServices.WebApp/ns.js"]"></script>
    @Head
</head>

<body>
    @Body
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    @* The language this document was rendered in, handed to the runtime as the framework's own
       applicationCulture: the client boots already speaking it instead of spending a round trip
       re-deriving an answer the request pipeline gave before the first byte
       (intentional-ui.md, "One arrival, one loading"). Started by hand only because an option
       bag has to reach Blazor.start, which is what autostart="false" leaves room for. *@
    <script>
        Blazor.start({ webAssembly: { applicationCulture: '@System.Globalization.CultureInfo.CurrentUICulture.Name' } });
    </script>
</body>

</html>

@code {

    [Parameter]
    public RenderFragment? Head { get; set; }

    [Parameter]
    public RenderFragment? Body { get; set; }
}