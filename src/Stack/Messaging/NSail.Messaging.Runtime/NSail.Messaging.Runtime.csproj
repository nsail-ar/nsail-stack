<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<!-- AfterCommit is the one thing here with something to say and nobody to say it to: its
		     drain runs past the point where raising could still mean anything. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<!-- The durable queue's two seams into the runtime, and the only assembly that gets
		     them: AmbientUnitOfWork, so a [Queue] send writes its row through the operation's
		     own transaction, and AmbientQueue.Run, so the drain can turn the gate's question
		     off for a delivery. Both are internal on purpose — one named consumer keeps the
		     list of things that can do either readable. -->
		<InternalsVisibleTo Include="NSail.Messaging.Queue" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Metadata\NSail.Metadata\NSail.Metadata.csproj" />
		<ProjectReference Include="..\..\Types\NSail.BclExtensions\NSail.BclExtensions.csproj" />
		<ProjectReference Include="..\..\Types\NSail.Types\NSail.Types.csproj" />
		<ProjectReference Include="..\NSail.Messaging\NSail.Messaging.csproj" />
	</ItemGroup>

</Project>

