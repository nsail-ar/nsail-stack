<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<RootNamespace>NSail.Storage</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Components\NSail.Components.Mud\NSail.Components.Mud.csproj" />
		<ProjectReference Include="..\NSail.Storage.Sdk\NSail.Storage.Sdk.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="strings*.json" />
		<EmbeddedResource Update="strings.*.json">
			<DependentUpon>strings.json</DependentUpon>
			<LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
			<WithCulture>false</WithCulture>
		</EmbeddedResource>
	</ItemGroup>

</Project>
