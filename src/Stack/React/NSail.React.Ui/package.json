{
  "name": "@nsail/ui",
  "version": "0.1.0",
  "description": "The Ns* components for a React client, drawn from the descriptors an Sdk generates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsail-ar/nsail-stack.git",
    "directory": "src/Stack/React/NSail.React.Ui"
  },
  "homepage": "https://github.com/nsail-ar/nsail-stack#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@nsail/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ns.css": {
      "@nsail/source": "./src/ns.css",
      "default": "./dist/ns.css"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@nsail/stack": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/ns.css', 'dist/ns.css')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
