{
  "name": "@nsail/ui",
  "version": "0.1.0",
  "description": "The Ns* components for a React client, drawn with MUI from the descriptors an Sdk generates and themed by the install's Brand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsail-ar/nsail-stack.git",
    "directory": "src/Stack/React/NSail.React.Ui"
  },
  "homepage": "https://github.com/nsail-ar/nsail-stack#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nsail/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@nsail/stack": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4"
  }
}
