@namespace NSail.Components
@using System.Collections.Concurrent
@using System.Net
@using System.Runtime.CompilerServices
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using NSail.Icons

@inject IServiceProvider Services

@if (Url is { } url && _kind != RemoteImageKind.Unavailable)
{
    <span @ref="_box" class="@GetClasses()" style="@GetStyle()">
        @if (_kind == RemoteImageKind.Svg && _markup is { } markup)
        {
            @((MarkupString)markup)
        }
        else
        {
            <img src="@url" alt="@Alt" />
        }
    </span>
}

@code {

    // A URL identifies content the same way an AssetId does for NsImage, so one probe per
    // URL serves every instance and every later render of it.
    // Keyed by the service scope (a circuit, a server-rendered request, a client app), so a
    // logo one tenant's host resolved is never served to another's, and no answer outlives
    // its scope.
    // Only a verdict is remembered -- a success or a 404; a transient failure (5xx, timeout,
    // network, a URL that cannot resolve) is shown as unavailable for that render and probed
    // again on the next parameter set.
    static readonly ConditionalWeakTable<IServiceProvider, ConcurrentDictionary<string, (RemoteImageKind Kind, string? Markup)>> Scopes = new();

    ConcurrentDictionary<string, (RemoteImageKind Kind, string? Markup)> Contents => Scopes.GetOrCreateValue(Services);

    enum RemoteImageKind
    {
        Raster,
        Svg,
        Unavailable
    }

    RemoteImageKind? _kind;
    string? _markup;
    string? _probed;
    bool _transient;
    string? _fitted;
    ElementReference _box;

    /// <summary>A well-known route this component fetches and decides by content type --
    /// never an app- or kit-specific default, so Stack names no URL of its own. An SVG
    /// answer is inlined only after <see cref="SvgSanitizer"/>, whatever the route served.</summary>
    [Parameter]
    public string? Url { get; set; }

    /// <summary>Rendered on the &lt;img&gt; branch only. The inlined SVG branch carries
    /// whatever accessible name the served markup already baked in -- this component parses
    /// nothing in that markup beyond the sanitizing, so it cannot stamp one on afterward.</summary>
    [Parameter]
    public string? Alt { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>The height of the box the mark is drawn into, in pixels — never a height it
    /// is stretched to: whichever of the two branches answers, the mark keeps its own
    /// proportion inside that box, and a width ceiling that bites takes the whole mark down
    /// with it rather than clipping one side (ns-mud.css). Without one, the box is the mark's
    /// own size.</summary>
    [Parameter]
    public int? Height { get; set; }

    /// <summary>Chrome only, reusing NsAs rather than founding a second enum (an
    /// NsImageAs.Primary would collide with NsAs.Main across the static imports):
    /// Inline (default) inherits the surrounding colour, Primary maps to the .text-primary
    /// utility. Meaningful only on the inlined-SVG branch (currentColor); a raster &lt;img&gt;
    /// ignores it, same as CSS color always would.</summary>
    [Parameter]
    public NsAs As { get; set; } = NsAs.Inline;

    protected override void OnParametersSet()
    {
        if (_transient)
        {
            _transient = false;
            _probed = null;
        }

        Build();
    }

    // The probe runs after the first render, never during it: prerendering has no transport
    // to fetch with, and the <img> it emits meanwhile is the correct answer for every URL
    // until the content type says otherwise.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Fit();

        if (Url is not { } url || _probed == url)
        {
            return;
        }

        // Asked from the service provider rather than injected: the prerendering host has no
        // HTTP transport of its own -- it is the origin -- and a required injection would fail
        // the whole page there, on a component whose <img> path never needed one.
        if (Contents.ContainsKey(url) || Services.GetService<IHttpClientFactory>() is not { } clients)
        {
            _probed = url;

            return;
        }

        _probed = url;

        var (result, remember) = await Probe(clients, url);

        if (remember)
        {
            Contents[url] = result;
        }
        else
        {
            if (Url != url)
            {
                return;
            }

            _transient = true;
            _kind = RemoteImageKind.Unavailable;
            _markup = null;
            StateHasChanged();

            return;
        }

        Build();

        StateHasChanged();
    }

    // The inlined mark is drawn to its artwork, not to the viewBox its file carries: getBBox
    // needs the element in the DOM, so it runs on the render that put the markup there, once
    // per URL. A host with no JS (prerendering) keeps the viewBox it was given.
    async Task Fit()
    {
        if (Url is not { } url || _kind != RemoteImageKind.Svg || _markup is null || _fitted == url)
        {
            return;
        }

        if (Services.GetService<IJSRuntime>() is not { } js)
        {
            return;
        }

        _fitted = url;

        try
        {
            await js.InvokeVoidAsync("nsapp.fitMark", _box);
        }
        catch (Exception e) when (e is InvalidOperationException or JSException or JSDisconnectedException)
        {
        }
    }

    static async Task<((RemoteImageKind Kind, string? Markup) Result, bool Remember)> Probe(IHttpClientFactory clients, string url)
    {
        try
        {
            // Headers first, so a raster drops the response the moment its content type
            // disqualifies it -- and the <img> already on screen reads the same URL out of
            // the browser cache rather than the network.
            using var response = await clients.CreateClient()
                .GetAsync(url, HttpCompletionOption.ResponseHeadersRead);

            if (!response.IsSuccessStatusCode)
            {
                return ((RemoteImageKind.Unavailable, null), response.StatusCode == HttpStatusCode.NotFound);
            }

            if (!string.Equals(response.Content.Headers.ContentType?.MediaType, "image/svg+xml", StringComparison.OrdinalIgnoreCase))
            {
                return ((RemoteImageKind.Raster, null), true);
            }

            var markup = await response.Content.ReadAsStringAsync();

            var clean = SvgSanitizer.Sanitize(markup);

            // Nothing drawable survives the allowlist: the file still shows as an image,
            // which cannot execute in the app's origin.
            return SvgSanitizer.HasDrawing(clean)
                ? ((RemoteImageKind.Svg, clean), true)
                : ((RemoteImageKind.Raster, null), true);
        }
        catch (Exception e) when (e is HttpRequestException or OperationCanceledException or InvalidOperationException or UriFormatException)
        {
            return ((RemoteImageKind.Unavailable, null), false);
        }
    }

    void Build()
    {
        if (Url is not { } url || !Contents.TryGetValue(url, out var entry))
        {
            _kind = null;
            _markup = null;

            return;
        }

        _kind = entry.Kind;
        _markup = entry.Markup;
    }

    string GetClasses()
    {
        return new NsClassBuilder("ns-remote-image")
            .Add("text-primary", As == NsAs.Main)
            .Add(Class)
            .ToString();
    }

    string? GetStyle()
    {
        return Height is { } height ? $"height:{height}px" : null;
    }
}
