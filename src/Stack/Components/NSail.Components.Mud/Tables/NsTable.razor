@namespace NSail.Components
@typeparam TRow where TRow : class
@inherits NsCollectionBase
@implements IFormRow
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor.Services
@using NSail.Exporting
@using NSail.Paging
@using NSail.Localization
@using Microsoft.JSInterop

@inject StringManager Strings
@inject LanguageProvider Language
@inject IJSRuntime JS
@inject IScrollListenerFactory ScrollListeners
@inject IBrowserViewportService Viewport
@inject IServiceProvider Services

@{
    RenderFragment defaultEmpty = @<NsText Secondary>@Strings.Translate("Common.NoRecords")</NsText>;

    RenderFragment noRecords = Empty ?? defaultEmpty;

    // Scroll mode's own NoRecordsContent, not the plain noRecords above: Items has no vendor
    // loading state of its own the way ServerData does — ServerData's own await is what
    // suppresses NoRecordsContent there, and Scroll's has nothing to. Without this, the
    // first query, and every ReloadRows's own _scrolled.Clear(), draws a false "no records"
    // on an answer nobody has yet — exactly the claim _hasLoaded exists to refuse. Null while
    // the overlay's own condition holds (IsRunning || !_hasLoaded) is the other face of
    // loadingOverlay below; once it is false either a real empty list draws here or rows do.
    RenderFragment? scrollNoRecords = IsRunning || !_hasLoaded ? null : noRecords;

    // Built once per render whether or not it draws here: a page header elsewhere on this
    // surface may be the one putting it on screen (ShowExportInline, Surface.Export), and
    // either way the trigger and its options are the same markup — one declaration, not two
    // copies that could drift. NsMenu already whispers its own Label through the house's one
    // bubble (CollapsedLabelWhisperTests), so nothing wraps it: a tooltip of its own on the same
    // word would be a second mechanism with its own answers about timing, clipping and scroll.
    RenderFragment? exportTrigger = Exportable && CanExport
        ? @<NsMenu Icon="@NsIcons.Download" Label="@Strings.Translate("Actions.Export")" Writes="false" Disabled="_exporting" Class="ns-table-export">
              @* Writes nothing, so a form that refuses writes keeps it: reading a list out is
                 not a way in (NsActBase). *@
              @foreach (var writer in Writers!.All)
              {
                  <NsMenuItem Action="@ExportAction(writer)" />
              }
          </NsMenu>
        : null;

    // Only a grid with no Title of its own competes for the header's slot: a Title names this
    // grid as a panel of a bigger page (ShowExportInline), and a panel's export stays beside
    // its own name rather than racing a sibling grid for one shared announcement. The slot's
    // holder is read before the announcement and not after: announcing calls back into this
    // grid's own ExportChanged handler, which answers by comparing against this field.
    _drawnExportHeader = Surface?.HasExportHeader ?? false;

    Surface?.AnnounceExport(this, Title is null ? exportTrigger : null);

    RenderFragment headerCells =
        @<text>
            @* The pass boundary for the column set, and the reason it can be one: this runs while
               the header's render tree is being BUILT, and the NsTh components in it set their
               parameters afterwards — so every declaration that follows belongs to this pass
               (TableColumns). *@
            @{ _columns.BeginPass(); }
            @if (Selectable)
            {
                <MudTh Class="ns-select">
                    <MudCheckBox T="bool?" TriState="true" Value="PageState()" ValueChanged="_ => TogglePage()"
                                 Dense="true" Size="Size.Small"
                                 UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = Strings.Translate("Common.SelectPage") })" />
                </MudTh>
            }
            @HeaderContent?.Invoke(default!)
            @if (Editable)
            {
                <NsTh />
            }
        </text>;

    RenderFragment<TRow> rowCells = item =>
        @<text>
            @if (Selectable)
            {
                @* The tick is not a click on the row: a grid whose rows open something would
                   otherwise open it on every tick. *@
                <MudTd Class="ns-select">
                    <span @onclick:stopPropagation="true">
                        <MudCheckBox T="bool" Value="IsSelected(item)" ValueChanged="selected => Toggle(item, selected)"
                                     Dense="true" Size="Size.Small"
                                     UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = Strings.Translate("Common.SelectRow") })" />
                    </span>
                </MudTd>
            }
            @if (IsEditing(item))
            {
                @* The open row answers its own refusal, so what its cells' fields announce is
                   announced HERE: this shadows the form's tracker and forwards to it (NsTab's
                   own rule), and the context the messages are posted to is the form's where
                   there is one — the row's fields already read that one — so nothing is wired
                   by the screen either way (RefusalPlacement). *@
                <CascadingValue TValue="EditContext" Value="RowContext" IsFixed="false">
                    <CascadingValue Value="(IFieldTracker)Placement" IsFixed="true">
                        @* Fixed: the marker is a constant and the cells under it are the row's own. *@
                        <CascadingValue Value="TableRowEdit.Open" IsFixed="true">
                            @RowEditor!(item)
                        </CascadingValue>
                        @* ns-row-commit and ns-row-edit below are what Enter inside a cell presses: the
                           key confirms the row and opens the one under it by running these very
                           controls, so there is no second path a row is committed by (ns.js, the Enter
                           policy). *@
                        <NsTd>
                            <NsStack Horizontal Gap="NsSize.Sm" Align="NsAlign.Center" Justify="NsAlign.End">
                                <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Never" Class="ns-row-commit" Icon="@NsIcons.Check" Label="@Strings.Translate("Actions.Confirm")" OnClick="@(() => Commit(item))" />
                                <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Never" Icon="@NsIcons.Close" Label="@Strings.Translate("Actions.Cancel")" OnClick="@(() => Cancel(item))" />
                            </NsStack>
                        </NsTd>
                    </CascadingValue>
                </CascadingValue>
            }
            else
            {
                @RowTemplate?.Invoke(item)
                @if (Editable)
                {
                    <NsTd>
                        <NsStack Horizontal Gap="NsSize.Sm" Align="NsAlign.Center" Justify="NsAlign.End">
                            @* The row's two controls carry the hooks the grid's keys press (ns.js): F2 opens
                               the row the cursor is on, Delete removes it through whatever confirmation
                               that button already asks for. The chord is declared on every row, and
                               which row answers is the row the keystroke was made in. *@
                            <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Never" Class="ns-row-edit" Icon="@NsIcons.Edit" Label="@Strings.Translate("Actions.Edit")" Chord="@NsKeys.Edit" Disabled="IsBusy" OnClick="@(() => Edit(item))" />
                            @if (OnRowRemove.HasDelegate)
                            {
                                <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Never" Class="ns-row-delete" Icon="@NsIcons.Delete" Label="@Strings.Translate("Actions.Delete")" Disabled="IsBusy" OnClick="@(() => Remove(item))" />
                            }
                        </NsStack>
                    </NsTd>
                }
            }
        </text>;

    @* What the open row's refusal named that the row renders no field for — a rule, a member no
       cell bound — as ONE strip directly under that row, which is where the row that caused it
       ends. A cell is one column wide and the answer belongs to the whole row, so the strip
       takes a row of its own (the vendor's nested-row slot) rather than a seat in the editor's
       cells: the row grows downward and nothing above it moves (intentional-ui.md, Refusal
       placement). It exists only while there is something to say, so a row nobody refused
       spends no height on the possibility. *@
    RenderFragment<TRow> problemRow = item =>
        @<text>
            @if (IsEditing(item) && Placement.Unplaced.Count > 0)
            {
                <tr class="ns-table-problem">
                    @* Past any column count on purpose: this row holds one cell and the columns
                       it has to cross are the header's, which the table does not count — a
                       computed column declares no key and the two the table seats itself are
                       conditional. A span wider than the table resolves to the whole row. *@
                    <td colspan="100">
                        <div class="ns-form-problem ns-form-problem-shown" role="alert">
                            <div class="ns-form-problem-text">
                                @foreach (var text in Placement.Unplaced)
                                {
                                    <span>@text</span>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </text>;

    @* The table's own two columns are the table's to seat here as well: the vendor wraps this
       fragment in a foot row that adds no cell of its own (CustomFooter off, nothing checkable
       or expandable), so a tick column or an edit column left unaccounted for would shift every
       figure one column off its header. Both placeholders are empty, which is also how they
       draw no card line stacked (ns-mud.css, the foot's :empty rule). *@
    RenderFragment footerCells =
        @<text>
            @if (Selectable)
            {
                <MudTd Class="ns-select" />
            }
            @* Fixed: the marker is a constant and the cells under it are the foot's own. *@
            <CascadingValue Value="TableFoot.Row" IsFixed="true">
                @FooterRow!(default!)
            </CascadingValue>
            @if (Editable)
            {
                <MudTd Class="ns-actions" />
            }
        </text>;

    @* Null is what keeps the tfoot off a table that declared no footer row: the vendor renders
       the element from the mere presence of this fragment. *@
    RenderFragment? footerContent = FooterRow is null ? null : footerCells;

    @* The vendor's own Loading row is IN FLOW (.mud-table-loading-row), so drops every row
       below it by the bar's own height and lifts them back up the moment the read answers —
       content moving twice for a state that carries no information. It is the ServerData
       branch's OWN await, drawn whether or not a Loading parameter is handed to it at all, so
       neither branch below passes one AND ns-mud.css neutralises the row itself
       (.ns-table .mud-table-loading-row). This fragment is drawn instead, as a sibling
       positioned OVER the table rather than a row INSIDE it (ns-table-loading-host, ns-mud.css),
       so the header and the rows it is reading never move. Null while nothing is running is
       what keeps the wrapper from drawing an empty hit-testing layer over a table that
       answered. *@
    RenderFragment? loadingOverlay = IsRunning || !_hasLoaded
        ? @<div class="ns-table-loading-overlay" role="status" aria-label="@Strings.Translate("Common.Loading")">
              <div class="ns-table-loading-scrim"></div>
              <NsIcon Icon="@NsIcons.Progress" Size="NsSize.Lg" />
          </div>
        : null;
}

@* Fixed: the instance outlives every render, and a column's Breakpoint is markup — cells
   would not re-read it anyway. *@
<CascadingValue Value="_columns" IsFixed="true">

@* The collection's own bar, and the only seat the controls over the WHOLE collection have: a
   grid that offers a way in names itself, so Agregar is at the top right on every screen and
   there is no second position for it to drift to — the same place a list page's NUEVO takes.
   Exportar is the other one of those: a named grid (a panel of a bigger page) keeps it here,
   beside its own name, while the page's own unnamed list hands it up to the header instead
   (exporting.md), ahead of Nuevo. Either way the bar still draws for a grid that has
   something of its own to put in it even where nothing named the grid: the pager row is the
   alternative seat, and it exists in only one of the three modes. *@
@if (Title is not null || ShowExportInline)
{
    <NsStack Horizontal Align="NsAlign.Center" Justify="NsAlign.SpaceBetween" Class="ns-collection-bar">
        @if (Title is not null)
        {
            <NsText As="NsTextAs.Title">@Title</NsText>
        }
        @* ms-auto and not the row's SpaceBetween alone: an unnamed bar has one child, and
           space-between seats a single child at the START — the controls would read as the
           grid's heading. *@
        <NsStack Horizontal Gap="NsSize.Sm" Align="NsAlign.Center" Class="ms-auto">
            @if (ShowExportInline)
            {
                @exportTrigger
            }
            @if (Editable && NewRow is not null && AddControl)
            {
                <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Never" Class="ns-cells-add" Icon="@NsIcons.Add" Label="@Strings.Translate("Actions.Add")" Disabled="IsBusy" OnClick="Add" />
            }
        </NsStack>
    </NsStack>
}

@if (OnQuery.HasDelegate && Scrolls)
{
    <div class="@GetHostClasses()">
        <MudTable T="TRow"
                  Items="_scrolled"
                  Class="@GetClasses()"
                  RowClassFunc="@((row, _) => GetRowClasses(row))"
                  OnRowClick="RowClick"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Dense="true"
                  FooterContent="@footerContent">
            <HeaderContent>
                @headerCells
            </HeaderContent>
            <RowTemplate>
                @rowCells(context)
            </RowTemplate>
            <ChildRowContent>
                @problemRow(context)
            </ChildRowContent>
            <NoRecordsContent>
                @scrollNoRecords
            </NoRecordsContent>
        </MudTable>
        @loadingOverlay
    </div>

    @* The floor the scroll listener aims at, and the way past it for anyone who cannot reach
       a floor: a first page shorter than the viewport never produces a scroll event, and a
       keyboard has no scroll gesture at all. *@
    @if (_hasLoaded && !_exhausted)
    {
        <NsStack Horizontal Justify="NsAlign.Center" Class="pa-2 ns-table-more">
            <NsButton Label="@Strings.Translate("Common.LoadMore")" Disabled="_fetching" OnClick="FetchNext" />
        </NsStack>
    }
}
else if (OnQuery.HasDelegate)
{
    <div class="@GetHostClasses()">
        <MudTable T="TRow"
                  ServerData="LoadPage"
                  @ref="_table"
                  Class="@GetClasses()"
                  RowClassFunc="@((row, _) => GetRowClasses(row))"
                  OnRowClick="RowClick"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Dense="true"
                  FooterContent="@footerContent">
            <HeaderContent>
                @headerCells
            </HeaderContent>
            <RowTemplate>
                @rowCells(context)
            </RowTemplate>
            <ChildRowContent>
                @problemRow(context)
            </ChildRowContent>
            <NoRecordsContent>
                @noRecords
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
        @loadingOverlay
    </div>
}
else
{
    <MudTable T="TRow"
              Items="HeldRows"
              Class="@GetClasses()"
              RowClassFunc="@((row, _) => GetRowClasses(row))"
              OnRowClick="RowClick"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Dense="true"
              FooterContent="@footerContent">
        <HeaderContent>
            @headerCells
        </HeaderContent>
        <RowTemplate>
            @rowCells(context)
        </RowTemplate>
        <ChildRowContent>
            @problemRow(context)
        </ChildRowContent>
        <NoRecordsContent>
            @noRecords
        </NoRecordsContent>
    </MudTable>
}

@* What a tick reaches is said out loud, and the one offer a page of ticks earns is made here:
   the rows no page has shown yet are part of the list the user is looking at, and an act over
   "all of them" must not quietly mean "the ones on screen". Below the rows and not above them:
   a bar that arrived with the first tick would push every row down under the pointer that is
   about to tick the second. *@
@if (Selectable && !Selection!.IsEmpty)
{
    var total = Shown.TotalCount;

    <NsStack Horizontal Gap="NsSize.Sm" Align="NsAlign.Center" Class="ns-selection-bar px-2">
        <NsText>@Counted("Common.Selected", Selection.Count(total))</NsText>
        @if (!Selection.All && total > InHand.Count && PageState() == true)
        {
            <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Always" Label="@Counted("Common.SelectAll", total)" OnClick="SelectAll" />
        }
        <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Always" Label="@Strings.Translate("Common.ClearSelection")" OnClick="ClearSelection" />
    </NsStack>
}

@* The family's own horizontal inset (ns-mud.css, .ns-collection-foot): a table's own cells
   carry the vendor's padding, but Footer is ordinary markup with none of its own — without
   the wrapper a document's totals sit flush against the card's border the moment the
   collection's lateral pa-4 is gone. *@
@if (Footer is not null)
{
    <div class="ns-collection-foot">
        @Footer
    </div>
}

</CascadingValue>

@code {

    // The page a scroll-mode table asks for. Page mode reads its own off the pager; scroll
    // mode has no pager to read one from.
    const int ScrollPageSize = 25;

    MudTable<TRow>? _table;
    readonly TableColumns _columns = new();
    TRow? _editing;
    bool _editingIsNew;
    bool _claimed;

    RefusalPlacement? _placement;
    EditContext? _own;
    ValidationMessageStore? _rowMessages;

    // Scroll mode's own state: the rows accumulated so far, where the next page starts, and
    // whether the server has nothing left to give. The instance class is what pins the
    // vendor's scroll listener to THIS table's container rather than the first one on screen.
    readonly string _instance = $"ns-table-{Guid.NewGuid():N}";
    readonly List<TRow> _scrolled = [];
    readonly Guid _viewportSubscription = Guid.NewGuid();
    IScrollListener? _listener;
    IDeviceProvider? _devices;
    Breakpoint? _breakpoint;
    bool _askedDevice;
    int _nextPage;
    bool _started;
    bool _listenerStarted;
    bool _fetching;
    bool _exhausted;

    // Which read is the current one, in both branches. Replacing a read only cancels it, and a
    // handler is free to ignore its token — most do, since reloading an NsLoad region does not
    // pass one on — so the generation the read was asked under, compared after the await, is
    // what tells a superseded answer from the one the grid is waiting for.
    int _generation;

    // The answer the grid is showing in page mode, kept because the Rows parameter is not it:
    // a superseded read's handler writes that one on its way out, after the read that replaced
    // it already put its own rows on screen.
    DataPage<TRow> _page = DataPage<TRow>.Empty();

    // A freshly mounted instance (every cold WASM hydration is one) starts at TotalItems 0
    // before its own first query has even begun — MudTable would paint NoRecordsContent for
    // that tick, a false "0 rows" indistinguishable from a genuinely empty result. Loading
    // stays forced on until the first page actually arrives, so the honest state before any
    // answer is "still asking", never "nothing here".
    bool _hasLoaded;

    // One export at a time, and the reason it is a field rather than the Runner's own IsRunning:
    // the export spends several runs, one per page, and between two of them the Runner is idle.
    bool _exporting;

    ExportWriters? _writers;
    bool _askedWriters;
    CancellationTokenSource? _export;

    // Whether a header held the export slot on the pass that drew this grid's bar. Read once at
    // the top of that pass and not again, so the seat the bar drew and the answer
    // OnExportChanged compares against are the same answer.
    bool _drawnExportHeader;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Grow { get; set; } = true;

    /// <summary>Names the table in a bar rendered above it, with the add control at the bar's
    /// right edge — the collection-editor chrome (Seña). Unset draws no bar at all, which also
    /// leaves the add control nowhere to live: a grid wired to add rows and left unnamed is
    /// refused by the Architecture suite rather than shipped with no way in.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Content pinned after the table, outside the grid — a labelled strip, a running
    /// difference, a submit — rendered whether or not Title is set. For figures that belong
    /// UNDER their columns use <see cref="FooterRow"/> instead.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>The table's own footer row, rendered as a real <c>tfoot</c>: one NsTd per
    /// column, each naming the column it totals (<c>For="() => context.Net"</c>, the same
    /// expression the NsTh above it carries), so a figure sits under its own header and stacks
    /// as a card line named by its own column on a phone. The cell with no For and no DataLabel
    /// is the one that names the row — Totales.
    /// <para>Cover the same columns HeaderContent does, leaving an EMPTY NsTd where a column
    /// has nothing to total: the tick column and the edit column are the table's own and it
    /// seats them here itself, so the counts cannot drift. The context is a typing crutch
    /// invoked with default!, exactly as HeaderContent's is.</para></summary>
    [Parameter]
    public RenderFragment<TRow>? FooterRow { get; set; }

    /// <summary>What the table says in place of the generic "no records" when the read came
    /// back with nothing — the screen's own words for an empty register. Shown under the same
    /// condition the default is: only once a read has answered.</summary>
    [Parameter]
    public RenderFragment? Empty { get; set; }

    // The table lays itself out: fills the available space when its parent is a
    // flex container (inert otherwise) and keeps the pager pinned at the bottom
    // (see .ns-table rules in ns-mud.css).
    //
    // ns-table-editing says a row is open, and ns-mud.css asks it two things. In column mode it
    // is the other half of "an edit input never hides": the editor's cells drop their hide
    // classes, and a table still laid out as a table would then have more cells in that row than
    // in its header, which lands the inputs under the wrong columns — so the WHOLE table stops
    // hiding while a row is open, header and read rows with it, and the counts stay equal. Under
    // md it is what stacks the table by CONTAINER instead (nsail#1614): no arithmetic seats an
    // open row in a container that narrow, so it becomes the form a phone already reads, where
    // there is no header and no count to match.
    //
    // ns-cells says the rows of this grid are TYPED INTO, which is what gives Enter its meaning
    // inside one: confirm the row and keep going down the column, never submit the document the
    // grid is a field of (ns.js, the Enter policy). A grid offering no way into a row is read,
    // not filled in, so its Enter is the document's.
    //
    // ns-table-pages says this grid drew a PAGER, which is the one branch whose rows are safe to
    // hand to the surface's own scroll once they stack as cards (ns-mud.css): the branch under it
    // reads the container's own scroll to fetch the next page, and there is no third answer a
    // class could be read as. Said in C# because only this component knows which branch rendered
    // — whether the grid STACKED is the vendor's own breakpoint call, which is why the CSS rule
    // needs both.
    string GetClasses()
    {
        return new NsClassBuilder("ns-table d-flex flex-column min-h-0")
            .Add("flex-grow-1", Grow)
            .Add("ns-cells", Editable)
            .Add("ns-table-editing", _editing is not null)
            .Add("ns-table-pages", OnQuery.HasDelegate && !Scrolls)
            .Add(_instance)
            .Add(Class)
            .ToString();
    }

    // ns-table-loading-host (ns-mud.css) sits between the table root and whatever panel sizes
    // it, so it owes the root's OWN flex role down the chain the root's box model lives
    // on: d-flex flex-column min-h-0, and flex-grow-1 whenever Grow asks the root itself to
    // take it. Without this the host is the flex item a panel's column sizes instead of the
    // root, the root's own flex-grow-1 does nothing inside a block-laid host, and the paged
    // grid's internal scroll and pinned pager (the container rule above) and Scroll mode's
    // own scroll listener both lose the box they measure against.
    string GetHostClasses()
    {
        return new NsClassBuilder("ns-table-loading-host d-flex flex-column min-h-0")
            .Add("flex-grow-1", Grow)
            .ToString();
    }

    string GetRowClasses(TRow row)
    {
        return new NsClassBuilder(OnRowClick.HasDelegate ? "cursor-pointer" : null)
            .Add(RowClass?.Invoke(row))
            .ToString();
    }

    // Handed to MudTable only when the page wired a row click: the vendor marks every row
    // mud-table-row-clickable — which is its cursor:pointer — from the mere presence of a
    // delegate, so a method of this component's own would promise a door on every grid in
    // the house. An empty callback is also the one shape MudTable reads as "no row click";
    // null is not assignable to it.
    EventCallback<TableRowClickEventArgs<TRow>> RowClick => OnRowClick.HasDelegate
        ? EventCallback.Factory.Create<TableRowClickEventArgs<TRow>>(this, HandleRowClick)
        : default;

    /// <summary>Per-row CSS class beyond the table's own chrome — the attention semaphore
    /// (theme severity utilities, never a custom color) paints a row from a condition its
    /// own data settles, not from a stored state. Null or empty leaves the row neutral.</summary>
    [Parameter]
    public Func<TRow, string?>? RowClass { get; set; }

    // The header context is a typing crutch invoked with default!: NsTh For expressions
    // over it ("() => context.DisplayName") are inspected for keys, never executed.
    [Parameter]
    public RenderFragment<TRow>? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment<TRow>? RowTemplate { get; set; }

    /// <summary>Cells shown while a row is edited in place — Ns* fields bound to the row,
    /// labelled and validated exactly as they would be on a form. Supplying it is what turns
    /// inline editing on; a table that leaves it unset behaves as it always did. A read-only or
    /// disabled form takes the offer back, editor and add control together, without the screen
    /// that supplied it having to say so.
    /// <para>Cover the same columns RowTemplate does: the confirm/cancel controls live in a
    /// column the table owns and adds to the header and to every row itself, so the counts
    /// cannot drift.</para></summary>
    [Parameter]
    public RenderFragment<TRow>? RowEditor { get; set; }

    /// <summary>Makes a blank row, adds it to the collection behind Rows and returns it —
    /// the table then opens it for editing. Supplying it is what puts the add control on the
    /// <see cref="Title"/> bar, so a row is added without a dialog.</summary>
    [Parameter]
    public Func<TRow>? NewRow { get; set; }

    /// <summary>Whether the table's bar draws its own add control. Off where the page already
    /// adds from chrome of its own — a tab strip's Agregar over the collection — and calls
    /// <see cref="Add"/>; NewRow still makes the row either way.</summary>
    [Parameter]
    public bool AddControl { get; set; } = true;

    /// <summary>The user confirmed the row being edited. Reject it by setting Cancel or
    /// Problem — either keeps the row open; anything else closes the editor.</summary>
    [Parameter]
    public EventCallback<RowEditEventArgs<TRow>> OnRowCommit { get; set; }

    /// <summary>The row leaves the collection: the delete control, cancelling a row that was
    /// never confirmed, or the document's submit taking back a new row nobody typed into
    /// (<see cref="NewRowEmpty"/>). Without a handler the delete control does not render.</summary>
    [Parameter]
    public EventCallback<RowEditEventArgs<TRow>> OnRowRemove { get; set; }

    /// <summary>Whether a row the table opened as NEW is one nobody typed into — asked of the
    /// screen, never guessed from TRow: what counts as typed in is the register's own word (a
    /// sale line is empty until an article is on it, whatever the quantity box shows).
    /// <para>Asked by the document's submit, and only of a never-confirmed row: a row this
    /// answers true for is taken back out through <see cref="OnRowRemove"/> and the save goes
    /// on, which is what makes the keyboard's own trailing row — Enter on the last row adds one
    /// — cost nothing. A screen that answers nothing keeps the default: every open row is
    /// committed or refused by its own rule, so no row is ever dropped in silence.</para></summary>
    [Parameter]
    public Func<TRow, bool>? NewRowEmpty { get; set; }

    [Parameter, EditorRequired]
    public DataPage<TRow> Rows { get; set; } = DataPage<TRow>.Empty();

    /// <summary>Server-side paging callback. Fires once on init and on every page/size change; without it the pager is hidden.</summary>
    [Parameter]
    public EventCallback<QueryEventArgs> OnQuery { get; set; }

    /// <summary>How arriving pages are shown: Page replaces the rows on screen with the one
    /// asked for, Scroll appends it below them, Auto (the default) scrolls on a phone and
    /// pages on every other machine. The request the server sees is identical in all three.</summary>
    [Parameter]
    public NsTableMode Mode { get; set; } = NsTableMode.Auto;

    [Parameter]
    public EventCallback<TRow> OnRowClick { get; set; }

    /// <summary>Turns row selection on: a tick at the head of every row, one in the header for
    /// the rows in hand, and — once every row in hand is ticked and the list holds more — the
    /// offer to reach every row the query answers (<see cref="Selection.All"/>). The table
    /// mutates the instance it is handed and raises <see cref="SelectionChanged"/>; a new
    /// search (Reload with first) empties it, since the rows it named belong to another
    /// result set.</summary>
    [Parameter]
    public Selection? Selection { get; set; }

    [Parameter]
    public EventCallback<Selection> SelectionChanged { get; set; }

    /// <summary>What tells two rows apart for <see cref="Selection"/>: a reloaded page brings
    /// new instances of the same rows, so a tick is kept by key and never by reference.</summary>
    [Parameter]
    public Func<TRow, Guid>? RowKey { get; set; }

    // The document this grid stands inside, if any, read for ONE question: whether the rows it
    // holds are a field of what a submit saves. A form is the only thing that cascades it, so a
    // grid that finds nothing here is a grid on a page that is merely read (CanExport).
    [CascadingParameter]
    IFormDocument? Document { get; set; }

    /// <summary>The form the table stands inside, where it stands inside one: its context is
    /// what the open row's own fields already read, so a message posted there needs no second
    /// cascade to reach them, and its tracker is what the open row forwards to.</summary>
    [CascadingParameter]
    EditContext? Form { get; set; }

    [CascadingParameter]
    IFieldTracker? Tracker { get; set; }

    /// <summary>The document's own register of open rows: the form's submit settles this table
    /// before it validates, so a row left open is committed, taken back out or refused with its
    /// own words (IFormRows). A table mounted outside any form has nobody to settle it.</summary>
    [CascadingParameter]
    IFormRows? OpenRows { get; set; }

    bool Selectable => Selection is not null && RowKey is not null;

    // Built on first use rather than in a field initializer: the words a refusal is said with
    // come from an injected StringManager, which does not exist while a field does.
    RefusalPlacement Placement => _placement ??= new RefusalPlacement(Strings);

    // The context the open row's fields read their own refusal off — the form's where the table
    // stands inside one, which is the case every editable grid in the house is, and one of the
    // table's own where there is none. The reasons for both, and for modelling the fallback on
    // the TABLE rather than on the row, are NsListEditor's: the same two lines answer the same
    // question for the same reason.
    EditContext RowContext => Form ?? (_own ??= new EditContext(this));

    // What the reader is looking at, which in page mode is the winning read's answer and not
    // the Rows parameter: a tick, its header's third state and the count over the selection bar
    // all have to agree with the rows on screen.
    DataPage<TRow> Shown => OnQuery.HasDelegate && !Scrolls ? _page : Rows;

    IReadOnlyList<TRow> InHand => OnQuery.HasDelegate && Scrolls ? _scrolled : Shown.Items;

    bool IsSelected(TRow row)
    {
        return Selection!.Contains(RowKey!(row));
    }

    // True when every row in hand is ticked, false when none is, null in between — the
    // header's third state, which a click resolves to "all of them".
    bool? PageState()
    {
        var rows = InHand;

        if (rows.Count == 0)
        {
            return false;
        }

        var ticked = rows.Count(IsSelected);

        if (ticked == rows.Count)
        {
            return true;
        }

        return ticked == 0 ? false : null;
    }

    Task TogglePage()
    {
        var selection = Selection!;
        var keys = InHand.Select(RowKey!).ToList();

        if (PageState() == true)
        {
            // Unticking the page while the whole list is selected leaves nothing: the rows
            // off-screen were only ever selected as part of "all".
            if (selection.All)
            {
                selection.Clear();
            }
            else
            {
                selection.Ids.RemoveAll(keys.Contains);
            }
        }
        else
        {
            selection.Ids.AddRange(keys.Where(key => !selection.Ids.Contains(key)));
        }

        return SelectionChanged.InvokeAsync(selection);
    }

    Task Toggle(TRow row, bool selected)
    {
        var selection = Selection!;
        var key = RowKey!(row);

        // One row out of "all" is no longer all: what stays ticked is what the user can see
        // ticked, the rows in hand minus this one.
        if (selection.All)
        {
            selection.All = false;
            selection.Ids = InHand.Select(RowKey!).Where(other => other != key).ToList();
        }
        else if (selected)
        {
            if (!selection.Ids.Contains(key))
            {
                selection.Ids.Add(key);
            }
        }
        else
        {
            selection.Ids.Remove(key);
        }

        return SelectionChanged.InvokeAsync(selection);
    }

    Task SelectAll()
    {
        Selection!.All = true;
        Selection.Ids.Clear();

        return SelectionChanged.InvokeAsync(Selection);
    }

    Task ClearSelection()
    {
        Selection!.Clear();

        return SelectionChanged.InvokeAsync(Selection);
    }

    string Counted(string key, int count)
    {
        return string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Translate(key, count), count);
    }

    // Auto asks the device, not the size: the answer rides in on the request, so it is already
    // in hand on the first render and no browser has to be measured for it. A phone therefore
    // never renders a pager at all, and a narrow desktop window still pages — the infinite
    // scroll is a touch gesture, not a consequence of narrow columns.
    bool Scrolls
    {
        get
        {
            return Mode switch
            {
                NsTableMode.Scroll => true,
                NsTableMode.Auto => IsPhone,
                _ => false
            };
        }
    }

    // Resolved, never injected: a host with no device seam registered — a component test, a
    // surface that is not a Blazor Web App — must still render its markup rather than fail to
    // construct it, and Page is what it gets, exactly like a desktop.
    bool IsPhone
    {
        get
        {
            if (!_askedDevice)
            {
                _askedDevice = true;
                _devices = Services.GetService(typeof(IDeviceProvider)) as IDeviceProvider;
            }

            return _devices?.IsPhone ?? false;
        }
    }

    // Handing the table an editor is what offers inline editing, and the form around it is
    // what may withdraw the offer: every control this table draws to change its rows — the
    // add, the pencil, the delete, the open editor itself — goes with it (NsCollectionBase).
    bool Editable => RowEditor is not null && ParentWritable;

    // One row at a time: while an editor is open every other row's controls are inert, so
    // there is no half-typed row to lose track of and no order to resolve between two.
    bool IsBusy => _editing is not null;

    // Reference identity, not equality: two rows carrying the same values are still two
    // rows, and only the one the user opened may render its editor.
    bool IsEditing(TRow item)
    {
        return Editable && _editing is not null && ReferenceEquals(_editing, item);
    }

    Task HandleRowClick(TableRowClickEventArgs<TRow> args)
    {
        if (args.Item is null || IsBusy)
        {
            return Task.CompletedTask;
        }

        return OnRowClick.InvokeAsync(args.Item);
    }

    /// <summary>Opens a new row for editing, as the table's own add control does — for a page
    /// that adds from its own chrome (<see cref="AddControl"/> off). Inert while a row is open,
    /// the same one-row-at-a-time rule the control keeps by being disabled.</summary>
    public void Add()
    {
        if (!Editable || NewRow is null || IsBusy)
        {
            return;
        }

        _editing = NewRow();
        _editingIsNew = true;

        StateHasChanged();
    }

    void Edit(TRow item)
    {
        _editing = item;
        _editingIsNew = false;
    }

    /// <summary>The document's submit, closing the row this table has open: a new row nobody
    /// typed into is taken back out (<see cref="NewRowEmpty"/>) and the save goes on, and any
    /// other open row has its own rule asked again on the values on screen — the keystroke
    /// already wrote them into the row, so what the boxes hold is what the handler is asked
    /// about. A row nothing refuses closes and the document saves in one tap; a refused one
    /// stays open wearing its own answer under the field that answer names (intentional-ui.md,
    /// Refusal placement).</summary>
    async Task<bool> IFormRow.Settle()
    {
        if (_editing is not { } row)
        {
            return true;
        }

        // The row the keyboard's last Enter minted and nobody filled in: it is in the collection
        // already — NewRow appends before returning, which is that parameter's contract — so the
        // save was going to write it, and the only answer that is not a lie is to take it back
        // out. Asked only of a never-confirmed row:
        // a row somebody once confirmed and reopened is an EDIT, and emptying its boxes is a
        // change the row's own rule answers for (hosts.md).
        if (_editingIsNew && NewRowEmpty is not null && NewRowEmpty(row))
        {
            await Discard(row);

            return true;
        }

        return await Commit(row);
    }

    /// <summary>Confirms the row and answers whether it took, which is what the document's
    /// submit reads to know it may go on (Settle). The press itself has no use for the answer:
    /// the row is either closed or standing there with its reason drawn.</summary>
    async Task<bool> Commit(TRow item)
    {
        // What the last press refused is lifted before this one runs: a message standing beside
        // a value the user has already corrected says the row is still refused when it is not.
        Placement.Clear();
        _rowMessages?.Clear();

        // The row's own declarations, asked before its handler and before the document's own
        // pass: the walk and the reason it runs here are RowAnnotations', shared with the list
        // editor's row so one open row owes one rule.
        _rowMessages ??= new ValidationMessageStore(RowContext);

        if (RowAnnotations.Refuses(Form?.Model, item, RowContext, _rowMessages, Strings))
        {
            return false;
        }

        var args = new RowEditEventArgs<TRow>
        {
            Row = item,
            IsNew = _editingIsNew
        };

        await Raise(OnRowCommit, args);

        // Raise reports a Problem rather than throwing it back, so the outcome is read off
        // the args: a rejected row must stay open where the user can still fix it.
        if (args.Cancel || args.Problem is not null)
        {
            return false;
        }

        Close();

        return true;
    }

    /// <summary>The open row answers its own refusal: an issue naming a field the row renders
    /// draws under that field, everything else as one strip on a row of its own under it — never
    /// a toast in a corner the user has to connect back to the row they just confirmed
    /// (intentional-ui.md, Refusal placement). With no row open there is nothing on screen to
    /// draw under, so the report goes on as it always did.</summary>
    public override async Task Report(ProblemEventArgs args)
    {
        ArgumentNullException.ThrowIfNull(args);

        if (!args.Handled && _editing is { } row && Placement.Place(args.Problem, row))
        {
            args.Handled = true;
        }

        await base.Report(args);
    }

    async Task Cancel(TRow item)
    {
        // A row that was never confirmed exists only because the user asked for one; backing
        // out of it leaves nothing to fall back to, so it goes.
        if (_editingIsNew)
        {
            await Discard(item);

            return;
        }

        Close();
    }

    // The never-confirmed row leaving, by the person's own Cancelar or by a submit that found
    // nothing typed into it (Settle). The editor closes BEFORE the notification goes out: the
    // row is off the screen either way, so a problem the remove handler reports has no open row
    // to be drawn on and takes the road any report with no host to claim it takes. The caller is
    // what takes the row out of the collection, because the caller's own factory is what put it
    // in (NewRow).
    async Task Discard(TRow item)
    {
        Close();

        await Raise(OnRowRemove, new RowEditEventArgs<TRow> { Row = item, IsNew = true });
    }

    Task Remove(TRow item)
    {
        return Raise(OnRowRemove, new RowEditEventArgs<TRow> { Row = item });
    }

    void Close()
    {
        // The row leaving takes its refusal with it: the editor that was refused is gone, and a
        // message left posted would draw under the next row opened on the same field. Its FIELDS
        // are let go of in the same breath, for the answer that has not arrived yet: the boxes
        // stand until the next render, and the document's own refusal about the row just settled
        // belongs at the form's foot, not under an input leaving the screen (RefusalPlacement).
        Placement.Clear();
        Placement.Forget();
        _rowMessages?.Clear();

        _editing = null;
        _editingIsNew = false;
    }

    /// <summary>MudBlazor drives paging through this: it owns the page and size, asks for a
    /// page, and reads the total off what comes back. Passing Items instead would make it
    /// count only the rows in hand and conclude there is a single page.</summary>
    async Task<TableData<TRow>> LoadPage(TableState state, CancellationToken cancellationToken)
    {
        var generation = ++_generation;

        var args = new QueryEventArgs
        {
            PageIndex = state.Page,
            PageSize = state.PageSize
        };

        // Replace: the page asked for last is the one the user is looking at. A search typed
        // while the previous page is still arriving asks again at once, and a second run on a
        // busy Runner throws — the vendor swallows that, so the search was simply lost and the
        // grid kept showing rows the new filter excludes.
        await Raise(OnQuery, args, RunOptions.Replace);

        // The page asked for last is also the one whose answer wins. A read superseded while it
        // was in flight still gets here — its handler ignored the cancellation, or honoured it
        // and the Runner swallowed the refusal — and the vendor assigns whatever comes back
        // with no check of its own, so the only way a superseded read changes nothing is to
        // hand back what is already on screen: not its rows, not its total, and so not the page
        // either, which the vendor bounds against that total right after the assign. Throwing
        // instead is not available — nothing in MudTable catches, and the escape lands on
        // NsErrorBoundary, which wraps the whole @Body, header and NUEVO link included.
        if (generation == _generation)
        {
            _hasLoaded = true;

            // The page assigns Rows while handling the query, so the fresh value is read from
            // the parameter right after — it is the same DataPage the caller just fetched.
            _page = Rows;

            // The loading overlay is drawn by THIS component, a render ahead of the one Raise's
            // own IsRunningChanged just asked for — that one landed before this line, while
            // _hasLoaded was still false, so it is this redraw that actually takes the overlay
            // down. MudTable needs none of this for its own rows: it reacts to this same
            // ServerData answer on its own render, and has no overlay of its own that needs
            // this call.
            StateHasChanged();
        }

        return new TableData<TRow>
        {
            Items = _page.Items,
            TotalItems = _page.TotalCount
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Mode == NsTableMode.Auto)
        {
            await SubscribeToViewport();
        }

        if (!OnQuery.HasDelegate || !Scrolls)
        {
            return;
        }

        // Scroll mode has no ServerData for MudTable to pull the first page through, so the
        // component asks for page 0 itself — on its first render, or on the render that turned
        // scrolling on for a table whose Mode its page changed.
        if (!_started)
        {
            _started = true;

            // Replace, not None: a Mode changed after the first render reaches this line with
            // the page branch's MudTable holding a ServerData query of its own on this
            // component's Runner. A second Run while one is going throws "Runner is already
            // running." straight out of OnAfterRenderAsync, into NsErrorBoundary, which wraps
            // @Body — the whole screen, header and NUEVO link included. The page in flight is
            // the one being superseded anyway: its answer belongs to a branch that no longer
            // exists.
            await Fetch(_generation, RunOptions.Replace);

            return;
        }

        // The vendor's listener resolves its selector ONCE, when it is subscribed, and a table
        // with no rows has no .mud-table-container to resolve to — a listener created before
        // the first page landed binds to nothing and never fires again. Subscribing is also
        // what starts it: IScrollListener has no Start, and the type that does is internal to
        // MudBlazor.
        //
        // Nothing here asks the listener for the container's geometry:
        // GetCurrentScrollDataAsync called from OnAfterRenderAsync freezes the circuit, so a
        // first page too short to scroll is covered by the Cargar más control instead.
        if (!_listenerStarted && _scrolled.Count > 0)
        {
            _listenerStarted = true;

            StartScrollListener();
        }
    }

    // Not called unguarded, and not retried: creating the listener and subscribing to it IS the
    // vendor's JS listener starting, and the JS side resolves the selector once with
    // querySelector — anything it throws (a container that is not there, a circuit whose JS is
    // gone) comes back as a JSException on this path, and an exception out of
    // OnAfterRenderAsync reaches NsErrorBoundary, which wraps the whole @Body: the grid would
    // take the page's header and its NUEVO link down with it. A listener that never starts
    // costs the scroll gesture and nothing else — Cargar más is already the way past exactly
    // that.
    void StartScrollListener()
    {
        try
        {
            _listener = ScrollListeners.Create($".{_instance} .mud-table-container");
            _listener.OnScroll += HandleScroll;
        }
        catch
        {
            _listener = null;
        }
    }

    // Same reason, same blast radius: SubscribeAsync is raw JS interop (ListenForResize, plus
    // GetBrowserWindowSize for the immediate answer) and lets a JSException straight out. A
    // viewport that cannot be measured costs the measurement and nothing else — no branch of
    // this table depends on one arriving.
    async Task SubscribeToViewport()
    {
        try
        {
            await Viewport.SubscribeAsync(
                _viewportSubscription,
                OnViewportChanged,
                new ResizeOptions { NotifyOnBreakpointOnly = true },
                fireImmediately: true);
        }
        catch
        {
            _breakpoint = null;
        }
    }

    void OnViewportChanged(BrowserViewportEventArgs args)
    {
        // A width of zero is not a narrow window, it is nobody measuring: the service answers
        // its immediate notification from whatever the JS side hands back, which off a browser
        // (bUnit, prerender) is an empty size that classifies as the smallest breakpoint.
        if (args.BrowserWindowSize is not { Width: > 0 })
        {
            return;
        }

        if (_breakpoint == args.Breakpoint)
        {
            return;
        }

        _breakpoint = args.Breakpoint;
        _ = InvokeAsync(StateHasChanged);
    }

    void HandleScroll(object? sender, ScrollEventArgs args)
    {
        if (_fetching || _exhausted)
        {
            return;
        }

        // A page-height of slack: the next page starts arriving before the reader hits the
        // floor, which is what makes it read as one list rather than as a stall.
        if (args.ScrollTop + args.ClientHeight < args.ScrollHeight - 200)
        {
            return;
        }

        _ = InvokeAsync(FetchNext);
    }

    Task FetchNext()
    {
        // One append at a time: pages have to arrive in order to be appended in order.
        if (_fetching || _exhausted)
        {
            return Task.CompletedTask;
        }

        return Fetch(_generation, RunOptions.None);
    }

    async Task Fetch(int generation, RunOptions options)
    {
        _fetching = true;

        var args = new QueryEventArgs
        {
            PageIndex = _nextPage,
            PageSize = ScrollPageSize
        };

        await Raise(OnQuery, args, options);

        // A reload that landed while this page was in flight already owns the list, and this
        // answer describes the result set it replaced — appending it would mix two searches.
        if (generation != _generation)
        {
            return;
        }

        _scrolled.AddRange(Rows.Items);
        _nextPage++;
        _hasLoaded = true;

        // Both conditions are needed: a total that lies, or a filter applied between two
        // pages, would otherwise keep asking forever, and an empty answer is the only
        // end-of-list signal a count cannot give.
        _exhausted = Rows.Items.Count == 0 || _scrolled.Count >= Rows.TotalCount;
        _fetching = false;

        StateHasChanged();
    }

    /// <summary>Re-runs the query after something changed the data. Pass first: true when the
    /// result set itself changed (a new search, a filter) — page 4 of the old results is not
    /// page 4 of the new ones.</summary>
    public async Task Reload(bool first = false)
    {
        if (first && Selectable && !Selection!.IsEmpty)
        {
            Selection.Clear();

            await SelectionChanged.InvokeAsync(Selection);
        }

        await ReloadRows(first);
    }

    Task ReloadRows(bool first)
    {
        if (Scrolls)
        {
            // Nothing to navigate: the accumulated list IS the position, so a reload of any
            // kind starts it over — no row from the previous result set survives.
            //
            // A page already in flight is SUPERSEDED, not waited for and not skipped: the
            // guard that keeps two appends in order would otherwise swallow the reload
            // outright, leaving the previous search's rows on screen. Replace cancels that
            // run, and the generation makes its answer stale if it arrives anyway.
            _generation++;
            _scrolled.Clear();
            _nextPage = 0;
            _exhausted = false;
            _fetching = false;

            return Fetch(_generation, RunOptions.Replace);
        }

        if (_table is null)
        {
            return Task.CompletedTask;
        }

        // MudTable's CurrentPage setter returns early when the page is unchanged, so
        // NavigateTo(0) from the first page queries nothing — the reload has to be asked
        // for. Where the page does change, NavigateTo already asks for it: one query either
        // way.
        if (first && _table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
            return Task.CompletedTask;
        }

        return _table.ReloadServerData();
    }

    // Resolved, never injected, exactly like the device seam above: a host with no export
    // registered — a component test, a surface that was never given one — must still render its
    // grid, and what it gets is a grid with no Exportar on it.
    ExportWriters? Writers
    {
        get
        {
            if (!_askedWriters)
            {
                _askedWriters = true;
                _writers = Services.GetService(typeof(ExportWriters)) as ExportWriters;
            }

            return _writers;
        }
    }

    // What a LIST is, said once: a grid whose rows are READ. A grid the SERVER pages is one by
    // construction, and so is a register whose every row arrived in one read — the kind a kit
    // writes when the whole table fits in the client — because "all pages" is every row either
    // way and a reader asking for a spreadsheet does not know which kind they are looking at.
    // What is NOT a list is a collection a DOCUMENT holds (its rows are a field of what the
    // submit saves, which is why the form itself is the test) and a grid typed into, whose own
    // rows are the thing being written. Derived rather than a parameter: a screen that had to
    // ask for Exportar is a screen that can forget to.
    bool CanExport => Writers is { IsEmpty: false } && RowEditor is null && (OnQuery.HasDelegate || HoldsItsList);

    // The seam the derivation above does not reach: whose ROWS a grid shows is not whose rows
    // are worth a spreadsheet. A list whose rows are the app's own machinery (an export request,
    // a background job, its own log) or a short vocabulary set up once (exporting.md) opts out
    // here rather than losing a column or a write seam it still needs for other reasons.
    [Parameter]
    public bool Exportable { get; set; } = true;

    // A Title'd grid is a panel of a bigger page and keeps its export beside its own name no
    // matter what else stands on the surface; an unnamed grid is a candidate for being the
    // PAGE's own list, so it only keeps its inline copy where no page header claimed the slot
    // (SurfaceContext.ClaimsExport) — the trigger never appears twice.
    bool ShowExportInline => Exportable && CanExport && (Title is not null || !_drawnExportHeader);

    // The one grid whose bar ASKS who holds the seat, and so the only one a slot that moves has
    // anything to say to: a Title'd grid keeps its own trigger whatever the surface does, and a
    // grid with nothing to export draws neither.
    bool CompetesForExportSeat => Exportable && CanExport && Title is null;

    // A grid with no paging callback: its rows are all in hand, so it is a list unless something
    // writes them. The two write seams a grid can carry without a RowEditor are the bar's way in
    // and the row controls — a collection that can be added to or taken from is being edited
    // whoever renders the cells.
    bool HoldsItsList => Document is null && NewRow is null && !OnRowCommit.HasDelegate && !OnRowRemove.HasDelegate;

    // Which grid a pressable heading is offered on, and it is the in-memory half of CanExport:
    // this grid holds every row of its list and does nothing but read them. A server-paged or a
    // scrolling one holds a slice, and ordering a slice reads as ordering the list; a grid typed
    // into is writing its rows rather than listing them (ui/hosts.md).
    bool OrdersInHand => !OnQuery.HasDelegate && RowEditor is null && HoldsItsList;

    // The rows the reader is looking at: the hand this grid holds, in the order a pressed heading
    // put it in. The FILE is written from this and not from the Rows parameter — a file in
    // another order than the list it came from is the same defect as one three hours off it
    // (exporting.md). With no heading pressed it is that parameter itself, reference and all,
    // which is the order the list's own handler settled.
    IReadOnlyList<TRow> HeldRows
    {
        get
        {
            if (_columns.Ordered is not { } column)
            {
                return Rows.Items;
            }

            return TableOrder.Sort(Rows.Items, column, _columns.Descending, RegionCulture.For(Language));
        }
    }

    protected override void OnInitialized()
    {
        _columns.OrderChanged += OnOrderChanged;

        if (Surface is not null)
        {
            Surface.ExportChanged += OnExportChanged;
        }
    }

    // A press lands on the heading's own control, and handling it re-renders that heading alone:
    // the rows are this component's to draw, so the order is this component's to redraw in.
    // Straight StateHasChanged and not InvokeAsync: the press is already on the renderer's
    // dispatcher, and the redraw belongs to the batch it is in.
    void OnOrderChanged()
    {
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Said by the table, because the table is what knows whether it holds the whole list, and
        // read by every heading under it: a column that declares itself sortable where nothing
        // can be ordered draws no control instead of one that would lie.
        _columns.Orders = OrdersInHand;

        Placement.Parent = Tracker;
        Placement.Bind(RowContext);

        // Claimed whatever the table is showing right now: RowEditor and the form's own writability
        // are parameters that can flip, and a table with no row open settles in one line — the
        // condition the claim would carry is the one Settle already answers.
        if (!_claimed && OpenRows is not null)
        {
            OpenRows.Claim(this);
            _claimed = true;
        }
    }

    // The only thing this grid's own render reads off the surface is whether a header holds the
    // export slot, and the event carries far more than that: every grid on the surface raises it
    // from every one of its own renders, this grid included, so redrawing for all of them would
    // rebuild the rows to emit what is on screen — and for the announcement this grid makes from
    // its own render body, it would be a loop. Two gates, because the event has two halves: a
    // grid that does not compete for the seat reads nothing the slot can change, and one that
    // does already drew the answer (_drawnExportHeader). A parameter that moves either gate is
    // a render of this grid's own, which is where that answer is taken again.
    void OnExportChanged()
    {
        if (!CompetesForExportSeat)
        {
            return;
        }

        if ((Surface?.HasExportHeader ?? false) == _drawnExportHeader)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    ActionItem ExportAction(IExportWriter writer)
    {
        return new ActionItem
        {
            Name = $"Export{writer.Kind}",
            Icon = writer.Icon,
            Writes = false,
            OnClick = () => Export(writer)
        };
    }

    async Task Export(IExportWriter writer)
    {
        // One at a time, and the menu says so by being disabled: two exports read their pages out
        // of the same Rows parameter, so a second one would interleave its pages into the first
        // one's file.
        if (_exporting || _columns.Declared.Count == 0)
        {
            return;
        }

        _exporting = true;
        _export = new CancellationTokenSource();

        var refused = false;

        // Named by what the screen calls the list, which is its own Title or the name its page
        // announced to the surface — never a string a caller passes, which would be the screen's
        // name written down twice.
        var name = Title ?? Surface?.Title ?? Strings.Translate("Actions.Export");

        var columns = _columns.Declared.ToArray();

        // Where the rows come from, which is the one thing the two kinds of list do not share: a
        // server-paged one is read page by page through its own OnQuery, and one whose rows are
        // already here is cut off the hand it holds, in the order the hand is being READ in
        // (HeldRows) — taken NOW, because the Rows parameter moves when the page that owns it
        // renders and a file written out of a moving parameter would be two filters' rows under
        // one heading.
        var rows = OnQuery.HasDelegate
            ? TableExport.Rows<TRow>(Read, columns, _export.Token)
            : TableExport.Held(HeldRows, columns, _export.Token);

        var book = ExportBook.Of(name, new ExportTable
        {
            Columns = [.. columns.Select(column => new ExportColumn { Key = column.Key, Title = column.Title, Format = column.Format })],
            Rows = rows
        });

        try
        {
            // The FILE is held, never the rows: a browser is handed a download as one blob, so the
            // bytes the writer produced stay in hand — a megabyte or two for tens of thousands of
            // rows — while the result set they came from is read a page at a time and dropped
            // (NSail.Exporting).
            using var file = new MemoryStream();

            await writer.WriteAsync(book, file, RegionCulture.For(Language), _export.Token);

            file.Position = 0;

            // A stream reference, not bytes: the file crosses to JS once and never as base64
            // (ns.js, download).
            using var reference = new DotNetStreamReference(file, leaveOpen: true);

            await JS.InvokeVoidAsync("nsapp.download", ExportWriters.FileName(book, writer), writer.ContentType, reference);
        }
        catch (ExportInterrupted) when (refused)
        {
            // The refusal is already on screen, placed by the Runner that raised the read. There
            // is nothing to add, and half a file is not offered.
        }
        catch (OperationCanceledException)
        {
            // The component ended, or the export was called off. Either way there is no screen
            // left to put a file or a refusal on.
        }
        catch (Exception ex)
        {
            await Report(new ProblemEventArgs(NSail.Problems.SystemProblem.Unhandled(), this, ex));
        }
        finally
        {
            _export.Dispose();
            _export = null;
            _exporting = false;

            StateHasChanged();
        }

        // One page of the export, asked for the only way this component ever asks for rows: the
        // screen's own OnQuery, so the message, its filter and its authorization are the list's
        // and an export needs nothing of its own.
        //
        // Null is a read that did not land, which TableExport turns into "no file": a refusal the
        // handler declared, or an answer that never reached this component. The answer travels as
        // the Rows PARAMETER, which moves when the page that owns it renders — handling an event
        // callback is what re-renders it, and the task InvokeAsync hands back does not complete
        // until that render has landed (LoadPage below reads it the same way, once per gesture).
        //
        // Nothing on screen moves while this runs: a page-mode grid renders _page and a
        // scroll-mode one _scrolled, and neither is written here.
        async Task<DataPage<TRow>?> Read(int index, int size)
        {
            var before = Rows;

            var args = new QueryEventArgs
            {
                PageIndex = index,
                PageSize = size
            };

            // Replace, for the same reason LoadPage replaces: a page the pager asked for may still
            // be in flight, and a second run on a busy Runner throws.
            await Raise(OnQuery, args, RunOptions.Replace);

            refused = args.Problem is not null;

            return refused || ReferenceEquals(Rows, before) ? null : Rows;
        }
    }

    // The two JS-side subscriptions are dropped without awaiting them: NsComponent's teardown is
    // synchronous, and the JS side of a listener whose circuit is going away has nothing left
    // to report to.
    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            if (_listener is not null)
            {
                _listener.OnScroll -= HandleScroll;
                _ = _listener.DisposeAsync();
                _listener = null;
            }

            _ = Viewport.UnsubscribeAsync(_viewportSubscription);

            // An export in flight has a screen to put its file on no longer, and its next page
            // would be a round trip asked for by nobody.
            _export?.Cancel();

            // The table's own end is where it lets go of the form's context: a refusal posted
            // there is the FORM's problem once the table is gone — nothing can lift it and the
            // form's own submit would refuse with nothing on screen to explain it. And the
            // register lets go of the table for the same reason: a submit that settled a grid no
            // longer on screen would raise OnRowCommit for a row nobody can see.
            _placement?.Bind(null);
            _rowMessages?.Clear();

            if (_claimed && OpenRows is not null)
            {
                OpenRows.Release(this);
                _claimed = false;
            }

            if (Surface is not null)
            {
                // Unhooked before the announcement below, which raises the event this grid is
                // subscribed to: a slot that moves while this instance is going away is nothing
                // it has left to draw.
                Surface.ExportChanged -= OnExportChanged;

                // A header holding this grid's trigger past its own teardown would offer Exportar
                // over a page that just said it could not read, or over a grid an @if turned off —
                // a no-op where some other grid already holds the slot.
                Surface.AnnounceExport(this, null);
            }
        }

        base.Dispose(disposing);
    }
}
