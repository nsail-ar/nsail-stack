@namespace NSail.Components
@using System.Linq.Expressions
@using NSail.Exporting
@using NSail.Icons
@using NSail.Localization
@using NSail.Metadata

@inject StringManager Strings
@inject MetadataProvider Metadata

<MudTh Class="@GetClasses()" UserAttributes="@Announced()">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (Presses)
    {
        @* The heading word IS the control's name, so a pressable column needs no string of its
           own and is anonymous to nobody (ui/actions.md). The arrow is drawn only on the column
           the list is ordered by: one of them points, the rest are plain words. *@
        <NsButton As="NsAs.Inline" Breakpoint="NsBreakpoint.Always" Class="ns-th-order"
                  Label="@_label" Icon="@Arrow()" OnClick="Press" />
    }
    else
    {
        @_label
    }
</MudTh>

@code {

    string? _key;
    string? _label;
    TableColumn? _column;
    Dictionary<string, object>? _announced;

    [CascadingParameter]
    TableColumns? Columns { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Field the column shows ("() => context.Name"): drives the localized header.
    /// The expression is inspected, never executed.</summary>
    [Parameter]
    public Expression<Func<object?>>? For { get; set; }

    /// <summary>Container width the column appears from, so a wide grid gives up its least
    /// important columns one at a time instead of collapsing all at once. Declared here and
    /// here only — the cells below follow. None (the default) keeps the column always.</summary>
    [Parameter]
    public NsSize Breakpoint { get; set; } = NsSize.None;

    /// <summary>Where the column is drawn on the compact row of a table that opted into it
    /// (<c>NsTable Compact</c>). Declared here like Breakpoint, and the cells below follow.
    /// </summary>
    [Parameter]
    public NsCompact Compact { get; set; } = NsCompact.Shown;

    /// <summary>What this column's values are in an exported file, for the one thing the member's
    /// own type cannot say: an amount and a share are both decimals. Unset is derived — a date
    /// member is a date, a numeric one a number, everything else text — so a column says this
    /// only when it means Money or Percent.</summary>
    [Parameter]
    public ExportFormat? Format { get; set; }

    /// <summary>Makes this heading a control the reader can press to order the list by this
    /// column — ascending, then descending, then ascending again, one column at a time. Per
    /// column and off by default: a heading orders only where the screen said that column
    /// orders. Silent on a column that names no field, and on a grid that holds a slice of its
    /// list rather than all of it — a server-paged or scrolling one — where the heading stays
    /// plain text (ui/hosts.md).</summary>
    [Parameter]
    public bool Sortable { get; set; }

    // A header that names no field and shows no text is the action column: it is the one
    // column with nothing to key on, which is already why it never hides. Deriving it here
    // is what lets the column's width belong to the column instead of to every grid.
    //
    // No heading is on the compact line — the stacked regimes hide the head row — so the one
    // compact marker a heading carries is the one that keeps an Only column off every other face.
    string GetClasses()
    {
        return new NsClassBuilder(NsResponsive.CellClasses(Breakpoint))
            .Add("ns-actions", For is null && ChildContent is null)
            .Add("ns-col-numeric", Columns?.IsNumericFor(_key) ?? false)
            .Add("ns-compact-only", Compact == NsCompact.Only)
            .ToString();
    }

    protected override void OnParametersSet()
    {
        var target = ForExpression.GetTarget(For);

        _key = target is { } named ? Metadata.KeyFor(named.Type, named.Member) : null;

        _label = _key is null ? null : Strings.Translate(_key);
        _column = null;

        if (_key is null || target is not { } field)
        {
            return;
        }

        // The same expression, the same key and the same heading the column already resolved,
        // handed on as what a file's column IS: a header that declares itself once is the whole
        // reason an export needs nothing from the screen.
        _column = TableColumn.Of(field.Type, field.Member, _label ?? _key, _key, Format, Strings);

        Columns?.Declare(_key, Breakpoint, Compact, IsNumeric(_column?.Format));

        if (_column is { } column)
        {
            Columns?.Declare(column);
        }
    }

    // Number, Money and Percent are figures; Text and Date read as words, a date's own digits
    // meaning a position on a calendar rather than a quantity to compare at a glance.
    static bool IsNumeric(ExportFormat? format)
    {
        return format is ExportFormat.Number or ExportFormat.Money or ExportFormat.Percent;
    }

    // A heading is pressable where the column asked for it, named a member to order by, and
    // stands in a grid that orders at all: ordering a server-paged grid's page would order a
    // slice and read as ordering the list (ui/hosts.md).
    bool Presses => Sortable && _column is not null && (Columns?.Orders ?? false);

    bool Ordered => _key is not null && Columns?.Ordered?.Key == _key;

    // The one mark the order gets: the column pressed points the way it is pointing, and no
    // other column carries a glyph at all — a third state the reader cannot tell from the order
    // the rows arrived in is a press spent on nothing (ui/hosts.md).
    Glyph? Arrow()
    {
        if (!Ordered)
        {
            return null;
        }

        return Columns!.Descending ? NsIcons.MoveDown : NsIcons.MoveUp;
    }

    // The arrow is the reader's mark and aria-sort is the same news for anyone who cannot see it,
    // off the same state and in no new words. Only on a pressable heading: on a plain one the
    // attribute would claim the column can be ordered and it cannot. Rebuilt only when that news
    // actually changes — a fresh dictionary every render reads as a changed parameter to the
    // vendor's cell (NsButton.OnParametersSet carries the same concern).
    Dictionary<string, object>? Announced()
    {
        var sort = Presses ? Ordered ? Columns!.Descending ? "descending" : "ascending" : "none" : null;

        if (sort is null)
        {
            _announced = null;
        }
        else if (_announced?.GetValueOrDefault("aria-sort") as string != sort)
        {
            _announced = new Dictionary<string, object> { ["aria-sort"] = sort };
        }

        return _announced;
    }

    void Press()
    {
        Columns!.Press(_column!);
    }
}
