@namespace NSail.Components
@using System.Linq.Expressions
@using NSail.Exporting
@using NSail.Localization
@using NSail.Metadata

@inject StringManager Strings
@inject MetadataProvider Metadata

<MudTh Class="@GetClasses()">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @_label
    }
</MudTh>

@code {

    string? _key;
    string? _label;

    [CascadingParameter]
    TableColumns? Columns { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Field the column shows ("() => context.Name"): drives the localized header.
    /// The expression is inspected, never executed.</summary>
    [Parameter]
    public Expression<Func<object?>>? For { get; set; }

    /// <summary>Container width the column appears from, so a wide grid gives up its least
    /// important columns one at a time instead of collapsing all at once. Declared here and
    /// here only — the cells below follow. None (the default) keeps the column always.</summary>
    [Parameter]
    public NsSize Breakpoint { get; set; } = NsSize.None;

    /// <summary>What this column's values are in an exported file, for the one thing the member's
    /// own type cannot say: an amount and a share are both decimals. Unset is derived — a date
    /// member is a date, a numeric one a number, everything else text — so a column says this
    /// only when it means Money or Percent.</summary>
    [Parameter]
    public ExportFormat? Format { get; set; }

    // A header that names no field and shows no text is the action column: it is the one
    // column with nothing to key on, which is already why it never hides. Deriving it here
    // is what lets the column's width belong to the column instead of to every grid.
    string GetClasses()
    {
        return new NsClassBuilder(NsResponsive.CellClasses(Breakpoint))
            .Add("ns-actions", For is null && ChildContent is null)
            .ToString();
    }

    protected override void OnParametersSet()
    {
        var target = ForExpression.GetTarget(For);

        _key = target is { } named ? Metadata.KeyFor(named.Type, named.Member) : null;

        _label = _key is null ? null : Strings.Translate(_key);

        if (_key is null || target is not { } field)
        {
            return;
        }

        Columns?.Declare(_key, Breakpoint);

        // The same expression, the same key and the same heading the column already resolved,
        // handed on as what a file's column IS: a header that declares itself once is the whole
        // reason an export needs nothing from the screen.
        if (TableColumn.Of(field.Type, field.Member, _label ?? _key, _key, Format, Strings) is { } column)
        {
            Columns?.Declare(column);
        }
    }
}
