@namespace NSail.Components
@inherits NsFieldBase<string>

<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              For="For"
              Label="@GetLabel()"
              Placeholder="@Placeholder"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="AutoFocus"
              Immediate="@IsImmediate"
              InputType="InputType.Password"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
@if (Measure() is { } strength)
{
    @* Advice, never a gate (nsail#501): the bar names what was typed and blocks nothing.
       role="status" so the verdict is announced without stealing focus from the field. *@
    <div class="ns-password-strength" role="status">
        <div class="ns-password-strength-track">
            <div class="@GetBarClasses(strength)"></div>
        </div>
        <NsText Secondary Size="NsSize.Xs">@Strings.Translate(strength)</NsText>
    </div>
}
<NsFieldHelper Text="@GetHelper()" Message="@GetErrorText()" DescribedBy="@DescribedBy" />

@code {

    const string StoredKey = "Components.NsPasswordField.Stored";

    /// <summary>Draws the strength verdict under the field while something is typed. It rides
    /// this field rather than standing on its own because the score has no meaning apart from
    /// the value it scores.</summary>
    [Parameter]
    public bool Strength { get; set; }

    /// <summary>Says a secret is already on file. A write-only credential never travels back,
    /// so the box opens empty on every visit and "nothing is stored" looks exactly like "the
    /// secret is stored and not shown" — this is the one line that tells them apart, and it
    /// says in the same breath that leaving the box alone keeps what is there. Off draws no
    /// helper node at all, never an empty one, and an explicit Helper still wins: the flag only
    /// fills a hint the caller wrote none of.</summary>
    [Parameter]
    public bool IsStored { get; set; }

    // A bar that only moved on blur would be advice about a password the user already
    // finished choosing, so asking for one asks for the keystroke-by-keystroke value too —
    // the caller is never left to remember a second flag for the first to work.
    bool IsImmediate => Immediate || Strength;

    // Null-coalescing and not a length test: a caller that named a blank Helper asked for no
    // hint, which is an answer, and a stored flag must not talk over it.
    string? GetHelper()
    {
        return Helper ?? (IsStored ? Strings.Translate(StoredKey) : null);
    }

    PasswordStrength? Measure()
    {
        return Strength ? PasswordScore.Measure(Value) : null;
    }

    static string GetBarClasses(PasswordStrength strength)
    {
        return $"ns-password-strength-fill ns-password-strength-{strength.ToString().ToLowerInvariant()}";
    }
}
