@namespace NSail.Components
@inherits NsTextFieldBase<string>

<div class="@GetBoxClasses()">
<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              Label="@GetLabel()"
              Placeholder="@GetPlaceholder()"
              ShrinkLabel="@ShowsStored"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="FocusOnRender"
              Immediate="true"
              MaxLength="@MaxTypedLength"
              OnBlur="Leaving"
              OnKeyDown="Pressing"
              InputType="@(Revealed ? InputType.Text : InputType.Password)"
              Adornment="@(CanReveal ? Adornment.End : Adornment.None)"
              AdornmentIcon="@(Revealed ? NsIcons.VisibilityOff.Markup : NsIcons.Visibility.Markup)"
              AdornmentAriaLabel="@Strings.Translate(Revealed ? HideKey : ShowKey)"
              OnAdornmentClick="Reveal"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
@* The wrapper is always present so the input is not remounted when the state flips. *@
@if (ShowsStored)
{
    <span class="ns-stored-mark" role="img" aria-label="@Strings.Translate(StoredHintKey)">
        <NsTooltip Text="@Strings.Translate(StoredHintKey)">
            <NsIcon Icon="NsIcons.Check" Size="NsSize.Sm" />
        </NsTooltip>
    </span>
}
</div>
@if (Measure() is { } strength)
{
    @* Advice, never a gate (nsail#501): the bar names what was typed and blocks nothing.
       role="status" so the verdict is announced without stealing focus from the field. *@
    <div class="ns-password-strength" role="status">
        <div class="ns-password-strength-track">
            <div class="@GetBarClasses(strength)"></div>
        </div>
        <NsText Secondary Size="NsSize.Xs">@Strings.Translate(strength)</NsText>
    </div>
}
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />

@code {

    const string StoredKey = "Components.NsPasswordField.Stored";
    const string StoredHintKey = "Components.NsPasswordField.StoredHint";
    const string ShowKey = "Components.NsPasswordField.Show";
    const string HideKey = "Components.NsPasswordField.Hide";

    bool _revealed;

    /// <summary>Draws the strength verdict under the field while something is typed. It rides
    /// this field rather than standing on its own because the score has no meaning apart from
    /// the value it scores.</summary>
    [Parameter]
    public bool Strength { get; set; }

    /// <summary>Says a secret is already on file. A write-only credential never travels back,
    /// so the box opens empty on every visit and "nothing is stored" looks exactly like "the
    /// secret is stored and not shown". The state lives inside the box — a short placeholder and
    /// a check whose whisper is the full sentence, leave it empty to keep it — so a narrow settings
    /// grid never grows a helper row. An explicit Helper and an explicit Placeholder still win,
    /// and both go once something is typed.</summary>
    [Parameter]
    public bool IsStored { get; set; }

    bool ShowsStored => IsStored && string.IsNullOrEmpty(Value);

    // The eye reveals what is typed and nothing else: a stored secret never travels back, so an
    // empty stored box has nothing to show and keeps its check instead. A box nobody can type in
    // has nothing to check either.
    bool CanReveal => !ShowsStored && !IsDisabled && !IsReadOnly;

    bool Revealed => _revealed && CanReveal;

    void Reveal()
    {
        _revealed = !_revealed;
    }

    string GetBoxClasses()
    {
        return new NsClassBuilder("ns-stored-box")
            .Add("ns-stored", ShowsStored)
            .Add(GrowClass)
            .ToString();
    }

    string? GetPlaceholder()
    {
        return Placeholder ?? (ShowsStored ? Strings.Translate(StoredKey) : null);
    }

    PasswordStrength? Measure()
    {
        return Strength ? PasswordScore.Measure(Value) : null;
    }

    static string GetBarClasses(PasswordStrength strength)
    {
        return $"ns-password-strength-fill ns-password-strength-{strength.ToString().ToLowerInvariant()}";
    }
}
