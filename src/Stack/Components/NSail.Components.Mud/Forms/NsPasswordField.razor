@namespace NSail.Components
@inherits NsTextFieldBase<string>

<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              Label="@GetLabel()"
              Placeholder="@GetPlaceholder()"
              ShrinkLabel="@ShowsStored"
              Adornment="@(ShowsStored ? Adornment.End : Adornment.None)"
              AdornmentIcon="@NsIcons.Check.Markup"
              AdornmentAriaLabel="@Strings.Translate(StoredHintKey)"
              IconSize="Size.Small"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="FocusOnRender"
              Immediate="true"
              MaxLength="@MaxTypedLength"
              OnBlur="Leaving"
              OnKeyDown="Pressing"
              InputType="InputType.Password"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
@if (Measure() is { } strength)
{
    @* Advice, never a gate (nsail#501): the bar names what was typed and blocks nothing.
       role="status" so the verdict is announced without stealing focus from the field. *@
    <div class="ns-password-strength" role="status">
        <div class="ns-password-strength-track">
            <div class="@GetBarClasses(strength)"></div>
        </div>
        <NsText Secondary Size="NsSize.Xs">@Strings.Translate(strength)</NsText>
    </div>
}
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />

@code {

    const string StoredKey = "Components.NsPasswordField.Stored";
    const string StoredHintKey = "Components.NsPasswordField.StoredHint";

    /// <summary>Draws the strength verdict under the field while something is typed. It rides
    /// this field rather than standing on its own because the score has no meaning apart from
    /// the value it scores.</summary>
    [Parameter]
    public bool Strength { get; set; }

    /// <summary>Says a secret is already on file. A write-only credential never travels back,
    /// so the box opens empty on every visit and "nothing is stored" looks exactly like "the
    /// secret is stored and not shown". While the box is empty the placeholder says so in a
    /// word and a check icon carries the whole sentence, including that leaving the box alone
    /// keeps what is there. It takes no row of its own, and an explicit Placeholder still wins.
    /// </summary>
    [Parameter]
    public bool IsStored { get; set; }

    bool ShowsStored => IsStored && string.IsNullOrEmpty(Value);

    // Null-coalescing and not a length test: a caller that named a blank Placeholder asked for
    // none, which is an answer, and a stored flag must not talk over it.
    string? GetPlaceholder()
    {
        return Placeholder ?? (ShowsStored ? Strings.Translate(StoredKey) : null);
    }

    PasswordStrength? Measure()
    {
        return Strength ? PasswordScore.Measure(Value) : null;
    }

    static string GetBarClasses(PasswordStrength strength)
    {
        return $"ns-password-strength-fill ns-password-strength-{strength.ToString().ToLowerInvariant()}";
    }
}
