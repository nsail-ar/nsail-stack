@namespace NSail.Components
@inherits NsTextFieldBase<string>

@if (KeyHint is { Length: > 0 })
{
    @* The key that commits the box, drawn inside it the way NsSearchField draws its chord and
       never written into the placeholder, which is the input's name fallback. Decoration only:
       aria-hidden, and only while the box is empty. *@
    <div class="@GetBoxClasses()" style="@GetBoxStyle()">
        @Field
        @if (IsKeyed)
        {
            <span class="ns-search-key" aria-hidden="true">@KeyHint</span>
        }
    </div>
}
else
{
    @Field
}
<NsFieldHelper Text="@GetHelperText()" Message="@GetErrorText()" DescribedBy="@DescribedBy" />
@if (_scanning)
{
    @* Escape is caught here and stopped: the innermost open thing wins it (ui/menus.md), and a
       hosted dialog's own listener is withdrawn through EscapeHolds while the camera is open. *@
    <div class="ns-camera" role="dialog" aria-modal="true" aria-label="@Strings.Translate(CameraKey)"
         @onkeydown="CameraKeyDown" @onkeydown:stopPropagation="true">
        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
            <video @ref="_video" class="ns-camera-view" muted playsinline autoplay></video>
            <div class="ns-camera-close">
                <NsButton As="NsAs.Inline"
                          Breakpoint="NsBreakpoint.Never"
                          Icon="@NsIcons.Close"
                          Label="@Strings.Translate(CameraCloseKey)"
                          OnClick="CloseCamera" />
            </div>
        </MudFocusTrap>
    </div>
}

@code {

    RenderFragment Field => @<MudTextField T="string"
                                           @ref="_box"
                                           Value="@GetDisplay()"
                                           ValueChanged="OnTextChanged"
                                           Mask="@GetMask()"
                                           Label="@GetLabel()"
                                           Placeholder="@Placeholder"
                                           Required="IsRequired"
                                           Disabled="IsDisabled"
                                           ReadOnly="IsReadOnly"
                                           AutoFocus="FocusOnRender"
                                           Immediate="true"
                                           MaxLength="@MaxTypedLength"
                                           OnBlur="Leaving"
                                           OnKeyDown="Pressing"
                                           ShrinkLabel="ShrinkLabel"
                                           Class="@(CanScan ? "ns-camera-field" : null)"
                                           Adornment="@(CanCopy || CanScan || Suffix is { Length: > 0 } ? Adornment.End : Adornment.None)"
                                           AdornmentText="@(CanCopy || CanScan ? null : Suffix)"
                                           AdornmentIcon="@GetEndIcon()"
                                           AdornmentAriaLabel="@GetEndLabel()"
                                           OnAdornmentClick="@EndClick"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Error="@HasError()"
                                           ErrorText="@GetErrorText()"
                                           UserAttributes="InputAttributes" />;
}
