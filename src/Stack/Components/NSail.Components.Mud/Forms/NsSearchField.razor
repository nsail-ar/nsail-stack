@namespace NSail.Components
@inherits NsTextFieldBase<string>

<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              Label="@GetLabel()"
              Placeholder="@GetPlaceholder()"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="AutoFocus"
              Immediate="true"
              MaxLength="@MaxTypedLength"
              OnBlur="Leaving"
              OnKeyDown="Pressing"
              DebounceInterval="Debounce"
              Class="@GrowClass"
              Clearable="true"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              IconSize="Size.Small"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />

@code {

    /// <summary>Milliseconds to wait after the last keystroke before the value updates —
    /// keeps a reactive filter from querying on every character. 0 updates immediately.</summary>
    [Parameter]
    public double Debounce { get; set; }

    // Every search box claims the key; WHICH one it lands in is the keyboard layer's answer and
    // not a parameter here — the page's search over the app map's in the drawer behind it
    // (ns.js, chordTarget). A box nobody can type in claims nothing, for the same reason a
    // disabled button answers no chord.
    protected override string? Chord => IsDisabled || IsReadOnly ? null : NsKeys.Search;

    string? GetPlaceholder()
    {
        return Placeholder ?? Strings.Translate("Common.Search");
    }
}
