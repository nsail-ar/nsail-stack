@namespace NSail.Components
@inherits NsFieldBase<string>

@using MudBlazor

<MudColorPicker Value="@MudValue"
                Text="@Value"
                TextChanged="SetColorValue"
                Label="@GetLabel()"
                Placeholder="@Placeholder"
                Required="IsRequired"
                Disabled="IsDisabled"
                ReadOnly="IsReadOnly"
                Editable="true"
                ShowAlpha="false"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Error="@HasError()"
                ErrorText="@GetErrorText()"
                UserAttributes="InputAttributes" />
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />
