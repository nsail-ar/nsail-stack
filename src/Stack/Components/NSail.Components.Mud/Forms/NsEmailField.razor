@namespace NSail.Components
@inherits NsFieldBase<string>

<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              For="For"
              Label="@GetLabel()"
              Placeholder="@Placeholder"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="AutoFocus"
              Immediate="Immediate"
              InputType="InputType.Email"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />
