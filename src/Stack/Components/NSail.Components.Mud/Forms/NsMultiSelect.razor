@namespace NSail.Components
@typeparam TItem
@typeparam TValue
@inherits NsFieldBase<IReadOnlyList<TValue>>

@* ShrinkLabel is declared off the SELECTION for the reason NsSelect's is declared off its
   value: the text this field shows is resolved out of Items, so a caller filling them from a
   read holds a selection for a render it cannot yet name. *@
<MudSelect T="TValue" MultiSelection="true"
           SelectedValues="(Value ?? []).ToList()" SelectedValuesChanged="OnChanged"
           ShrinkLabel="@HoldsValues()"
           ToStringFunc="GetValueText"
           Label="@GetLabel()" Placeholder="@Placeholder"
           Required="IsRequired"
           Disabled="IsDisabled"
           ReadOnly="IsReadOnly"
           Variant="Variant.Outlined" Margin="Margin.Dense"
           Error="@HasError()" ErrorText="@GetErrorText()"
           UserAttributes="InputAttributes">
    @if (Items is not null)
    {
        @foreach (var item in Items)
        {
            <MudSelectItem T="TValue" Value="@GetItemValue(item)">@GetItemText(item)</MudSelectItem>
        }
    }
</MudSelect>
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />

@code {

    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter, EditorRequired]
    public Func<TItem, TValue> ItemValue { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, string> ItemText { get; set; } = default!;

    protected override bool IsValueEmpty()
    {
        return Value is not { Count: > 0 };
    }

    bool HoldsValues()
    {
        return !IsValueEmpty();
    }

    // MudSelect re-raises its selection when the model hands it one; a set equal to the held
    // one is that echo, not an edit.
    Task OnChanged(IEnumerable<TValue> selected)
    {
        var list = selected.ToList();

        if ((Value ?? []).SequenceEqual(list))
        {
            return Task.CompletedTask;
        }

        return SetValue(list);
    }

    protected override string? FallbackLabel(string key)
    {
        if (Strings.TryTranslate(Metadata.KeyFor(typeof(TItem)), out var concept))
        {
            return concept;
        }

        return base.FallbackLabel(key);
    }

    TValue GetItemValue(TItem item)
    {
        return ItemValue(item);
    }

    string GetItemText(TItem item)
    {
        return ItemText(item);
    }

    string GetValueText(TValue value)
    {
        if (Items is null)
        {
            return string.Empty;
        }

        var item = Items.FirstOrDefault(candidate => Equals(GetItemValue(candidate), value));
        return item is null ? string.Empty : GetItemText(item);
    }
}
