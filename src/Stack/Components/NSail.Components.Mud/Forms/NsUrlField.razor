@namespace NSail.Components
@inherits NsTextFieldBase<string>

<MudTextField T="string"
              Value="Value"
              ValueChanged="SetValue"
              Label="@GetLabel()"
              Placeholder="@Placeholder"
              Required="IsRequired"
              Disabled="IsDisabled"
              ReadOnly="IsReadOnly"
              AutoFocus="AutoFocus"
              Immediate="true"
              OnBlur="Leaving"
              OnKeyDown="Pressing"
              InputType="InputType.Url"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Error="@HasError()"
              ErrorText="@GetErrorText()"
              UserAttributes="InputAttributes" />
<NsFieldHelper Text="@Helper" Message="@GetErrorText()" DescribedBy="@DescribedBy" />
