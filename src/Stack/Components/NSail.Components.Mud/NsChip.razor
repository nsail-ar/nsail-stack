@namespace NSail.Components

@using NSail.Icons

@* The note rides the chip itself rather than a wrapper of its own: the whisper is one element
   in the top layer (ns-mud.css, THE WHISPER), so what declares it needs no box around it, and
   a chip in a flex row keeps the row's own geometry. A note that only repeats the chip's text
   is never shown — that is ns.js's own rule and nothing here gates on it. *@
@if (OnClose is null)
{
    <MudChip T="string" Disabled="Disabled" Icon="@(Icon?.Markup)" data-ns-whisper="@Tooltip">@Text</MudChip>
}
else
{
    <MudChip T="string" Disabled="Disabled" Icon="@(Icon?.Markup)" OnClose="Close" data-ns-whisper="@Tooltip">@Text</MudChip>
}

@code {

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>An entry of an icon catalog — the chip's own glyph beside its text, name
    /// and glyph together saying what the value IS without leaning on color.</summary>
    [Parameter]
    public Glyph? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public Action? OnClose { get; set; }

    void Close(MudChip<string> chip) => OnClose?.Invoke();
}
