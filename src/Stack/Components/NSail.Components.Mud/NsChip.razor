@namespace NSail.Components

@using NSail.Icons

@* The note rides the chip itself rather than a wrapper of its own: the whisper is one element
   in the top layer (ns-mud.css, THE WHISPER), so what declares it needs no box around it, and
   a chip in a flex row keeps the row's own geometry. A note that only repeats the chip's text
   is never shown — that is ns.js's own rule and nothing here gates on it. *@
@if (OnClose is null)
{
    <MudChip T="string" Disabled="Disabled" Icon="@(Icon?.Markup)" Color="@GetColor()" Variant="@GetVariant()"
             Size="@GetSize()" Href="@Href" data-ns-whisper="@Tooltip">@Text</MudChip>
}
else
{
    <MudChip T="string" Disabled="Disabled" Icon="@(Icon?.Markup)" Color="@GetColor()" Variant="@GetVariant()"
             Size="@GetSize()" Href="@Href" OnClose="Close" data-ns-whisper="@Tooltip">@Text</MudChip>
}

@code {

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>An entry of an icon catalog — the chip's own glyph beside its text, name
    /// and glyph together saying what the value IS without leaning on color.</summary>
    [Parameter]
    public Glyph? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public Action? OnClose { get; set; }

    /// <summary>The state the chip names, worn as a soft tint of the severity's own color. Null
    /// is the neutral chip every list value uses. Pair it with an Icon: the tint alone says
    /// nothing to someone who cannot see it.</summary>
    [Parameter]
    public NsSeverity? Severity { get; set; }

    /// <summary>Makes the whole chip a link. The caller derives it from the route table, the
    /// way NsPageLink does; a chip never takes a literal address.</summary>
    [Parameter]
    public string? Href { get; set; }

    Color GetColor()
    {
        return Severity switch
        {
            NsSeverity.Success => Color.Success,
            NsSeverity.Warning => Color.Warning,
            NsSeverity.Error => Color.Error,
            NsSeverity.Info => Color.Info,
            _ => Color.Default
        };
    }

    Variant GetVariant()
    {
        return Severity is null ? Variant.Filled : Variant.Text;
    }

    Size GetSize()
    {
        return Severity is null ? Size.Medium : Size.Small;
    }

    void Close(MudChip<string> chip) => OnClose?.Invoke();
}
