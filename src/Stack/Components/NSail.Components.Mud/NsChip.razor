@namespace NSail.Components

@using NSail.Icons

@* The note rides the chip itself rather than a wrapper of its own: the whisper is one element
   in the top layer (ns-mud.css, THE WHISPER), so what declares it needs no box around it, and
   a chip in a flex row keeps the row's own geometry. A note that only repeats the chip's text
   is never shown — that is ns.js's own rule and nothing here gates on it. data-ns-whisper-tap
   is what lets a touch tap open the note at once (ns.js, THE TAP), the chip's alone among the
   controls that whisper; the bubble's link is the chip's own Href. *@
@if (OnClose is null)
{
    <MudChip T="string" Class="ns-chip-ellipsis" Disabled="Disabled" Icon="@(Icon?.Markup)" Color="@GetColor()" Variant="@GetVariant()"
             Size="@GetSize()" Href="@SafeHref" data-ns-whisper="@Tooltip" data-ns-whisper-tap="true" role="@GetRole()" aria-label="@GetName()">@Text</MudChip>
}
else
{
    <MudChip T="string" Class="ns-chip-ellipsis" Disabled="Disabled" Icon="@(Icon?.Markup)" Color="@GetColor()" Variant="@GetVariant()"
             Size="@GetSize()" Href="@SafeHref" OnClose="Close" data-ns-whisper="@Tooltip" data-ns-whisper-tap="true" role="@GetRole()" aria-label="@GetName()">@Text</MudChip>
}

@code {

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>An entry of an icon catalog — the chip's own glyph beside its text, name
    /// and glyph together saying what the value IS without leaning on color.</summary>
    [Parameter]
    public Glyph? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public Action? OnClose { get; set; }

    /// <summary>The state the chip names, worn as a soft tint of the severity's own color. Null
    /// is the neutral chip every list value uses. Pair it with an Icon: the tint alone says
    /// nothing to someone who cannot see it.</summary>
    [Parameter]
    public NsSeverity? Severity { get; set; }

    /// <summary>With a Severity, wears it as the filled face — the severity's own fill and the
    /// ink picked to read on it (branding.md's TextOn*) — instead of the soft tint. For a state
    /// that has to read from across the screen; the tint stays the list value's. No effect
    /// without a Severity.</summary>
    [Parameter]
    public bool Solid { get; set; }

    /// <summary>Makes the whole chip a link. The caller derives it from the route table, the
    /// way NsPageLink does; a chip never takes a literal address.</summary>
    [Parameter]
    public string? Href { get; set; }

    // A scheme no door may open (javascript:, data:), or an address the browser reads as another
    // host or scheme (//host, java<TAB>script:), is drawn as no address at all.
    string? SafeHref => SurfaceContext.IsInert(Href) ? null : Href;

    // Label in Name (WCAG 2.5.3): the visible text first, then the sentence, so a reader that
    // never sees the bubble hears it and a voice command by the visible word still matches. A
    // sentence that already opens with the text is said once.
    string? GetName()
    {
        var sentence = Tooltip?.Trim();
        var text = (Text ?? "").Trim();

        if (string.IsNullOrEmpty(sentence) || string.Equals(sentence, text, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return sentence.StartsWith(text, StringComparison.OrdinalIgnoreCase) ? sentence : $"{text}: {sentence}";
    }

    // With no Href the vendor's root is a bare div, a generic that ARIA forbids a name and the
    // browsers drop it from; a group takes the name and keeps the close button inside it
    // reachable. An anchor is a link and is named as it is.
    string? GetRole()
    {
        return string.IsNullOrEmpty(SafeHref) && GetName() is not null ? "group" : null;
    }

    Color GetColor()
    {
        return Severity switch
        {
            NsSeverity.Success => Color.Success,
            NsSeverity.Warning => Color.Warning,
            NsSeverity.Error => Color.Error,
            NsSeverity.Info => Color.Info,
            _ => Color.Default
        };
    }

    Variant GetVariant()
    {
        return Severity is null || Solid ? Variant.Filled : Variant.Text;
    }

    Size GetSize()
    {
        return Severity is null ? Size.Medium : Size.Small;
    }

    void Close(MudChip<string> chip)
    {
        OnClose?.Invoke();
    }
}
