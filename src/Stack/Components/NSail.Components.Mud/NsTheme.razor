@namespace NSail.Components
@using NSail.Tones

@* The one place a Brand becomes the --mud-palette-* variables every surface reads its colour
   from: the vendor stylesheet ships no :root defaults, so those variables are UNSET until this
   mounts and anything drawn without it paints from nothing. Two callers -- NsSetup, above the
   app, and a document rendered with no app around it (NsProblemDocument, the page a request
   that died before render answers with). The vendor's own scrollbar block stays off
   (DefaultScrollbar): its html, body * rule out-matches the bar every scroller inherits from
   ns-mud.css's :root, and paints a literal grey in both schemes. *@
<MudThemeProvider @ref="_provider" Theme="@_theme" IsDarkMode="@_dark" DefaultScrollbar="true" />
<style>@_variables</style>

@code {

    // Reached by a client the prerender never handed anything to, and by a request that died
    // before anything could resolve a brand. It is deliberately colourless: any accent here is
    // a guess about an organization nobody has asked about yet, and a wrong guess is what the
    // eye reads as a flash when the real one arrives. MudBlazor's own default is worse --
    // purple, and it would hold for the whole round-trip.
    static readonly Brand Fallback = Neutral();

    MudThemeProvider? _provider;
    Brand? _painted;
    Brand _checked = Fallback;
    MudTheme _theme = BrandMudTheme.From(Fallback);
    string _deviceDark = string.Empty;
    bool _dark;
    string _variables = string.Empty;

    // What the OS last reported, read once on the client (GetSystemDarkModeAsync) and kept
    // current by the vendor's own change watcher (WatchSystemDarkModeAsync, Observe
    // SystemDarkModeChange defaulting to true). Null until a client answers — a prerender, or a
    // request with no circuit at all, never asks — and an unset preference is then painted by
    // the stylesheet's own reading of the device (DeviceDark).
    bool? _systemDark;

    // The light-only tint's weight toward Info (--ns-alert-info-bg below); internal so the
    // contrast sweep measures this value rather than a second copy of it.
    internal const double AlertInfoTintWeight = 0.12;

    /// <summary>The brand painted. Null is "nothing resolved one", which paints the neutral
    /// grey rather than a guess — never a default <see cref="Brand"/>, which the eye reads as
    /// the wrong organization's colour.</summary>
    [Parameter]
    public Brand? Brand { get; set; }

    /// <summary>The reader's own dark-mode preference; null follows the device's scheme, from the
    /// first paint and live.</summary>
    [Parameter]
    public bool? Dark { get; set; }

    protected override void OnParametersSet()
    {
        var brand = Brand ?? Fallback;

        // A fresh MudTheme is a fresh object for the provider to diff and 26 elevations to
        // build, so the mapping runs when the brand itself moved and not on every re-render.
        if (!ReferenceEquals(brand, _painted))
        {
            _painted = brand;
            _checked = brand.Checked();
            _theme = BrandMudTheme.From(_checked);
            _deviceDark = DeviceDark(_checked, _theme);
        }

        (_dark, _variables) = Resolve(_checked);
    }

    // The OS query is a client fact (window.matchMedia), so it is asked exactly once, after the
    // first interactive render — never during a prerender, which has no window to ask and
    // leaves the device's scheme to the stylesheet. The live watcher rides the vendor's default
    // ObserveSystemDarkModeChange rather than a second one of our own: WatchSystemDarkModeAsync
    // only subscribes to what that watcher already reports. Unconditional on Dark's own value:
    // Resolve's own order (Dark before _systemDark) is what keeps a saved Claro/Oscuro from ever
    // repainting over this, so a later switch to Automático (Dark turning null on an
    // already-mounted NsTheme) still has a current reading to paint.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _provider is null)
        {
            return;
        }

        await _provider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);

        await OnSystemDarkModeChanged(await _provider.GetSystemDarkModeAsync());
    }

    // A reading that leaves the markup as it is costs no render, which keeps an explicit
    // Claro/Oscuro at the one it had. The first answer under an unset preference always costs
    // NsTheme one, and the eye sees none of it: the scheme it settles on is the one the
    // stylesheet's media query already lit.
    async Task OnSystemDarkModeChanged(bool isDark)
    {
        _systemDark = isDark;

        var (dark, variables) = Resolve(_checked);

        if (dark == _dark && variables == _variables)
        {
            return;
        }

        _dark = dark;
        _variables = variables;
        await InvokeAsync(StateHasChanged);
    }

    // The brand never picks the scheme. Until the device has answered (a prerender, a document
    // with no circuit, a WASM boot's first render) an unset preference paints light under a
    // prefers-color-scheme block that relights it dark: the same media feature matchMedia reads,
    // so the first paint already wears the scheme the answer will confirm.
    (bool Dark, string Variables) Resolve(Brand brand)
    {
        var dark = Dark ?? _systemDark;

        if (dark is null)
        {
            return (false, Root(brand, dark: false) + _deviceDark + FontFace(brand.Typeface));
        }

        return (dark.Value, Root(brand, dark.Value) + FontFace(brand.Typeface));
    }

    // The vendor's own declarations for the dark scheme, kept to the ones light's disagree with,
    // beside the NSail ones: what the provider would have emitted with IsDarkMode on.
    static string DeviceDark(Brand brand, MudTheme theme)
    {
        var dark = VendorPalette.Declarations(theme, dark: true);
        var light = VendorPalette.Declarations(theme, dark: false).ToHashSet(StringComparer.Ordinal);
        var differing = string.Concat(dark.Where(declaration => !light.Contains(declaration)));

        return "@media (prefers-color-scheme: dark){"
            + Root(brand, dark: true)
            + $":root{{{differing}}}"
            + "}";
    }

    // The vendor emits the palette of the scheme that is lit and nothing else, so the NSail
    // variables a stylesheet cannot compute ride beside it, for that same scheme: the accent as
    // INK is a decision about the accent's own luminance, and color-mix has no way to see how
    // bright a colour is. Two of them for that reason, because the accent is read on two kinds
    // of ground — the content's fixed surfaces, and the freely picked chrome the drawer wears —
    // and one value over both would be a light chrome's ink chosen against a dark scheme's
    // card. Everything else stays in ns-mud.css, where a wash mixed against transparent
    // belongs, EXCEPT the three below, which are not about luminance but about which of the
    // two schemes is lit — the one thing MudThemeProvider answers by swapping a palette's worth
    // of --mud-palette-* variables in place, with no lasting selector of its own a stylesheet
    // rule could key off (ns-mud.css's own note on .ns-drawer). A card's elevation ring
    // (BrandMudTheme.BuildElevations) and the content aside's own box-shadow both read
    // --ns-elevation-ring; a filled info alert, the one severity with no loud news to carry,
    // reads the other two as a light-only tint — dark's pair restates the vendor's own flat
    // fill so nothing there moves. color-scheme is the same fact for the browser:
    // its native controls, and any scrollbar the house's bar does not reach, paint from it.
    static string Root(Brand brand, bool dark)
    {
        var scheme = dark ? brand.Dark : brand.Light;

        var elevationRing = dark ? "rgba(255,255,255,.06)" : "rgba(0,0,0,.08)";
        var alertInfoBg = dark ? scheme.Info : BrandTone.Mix(scheme.Surface, scheme.Info, AlertInfoTintWeight);
        var alertInfoBorder = dark ? "transparent" : scheme.Info;
        var alertInfoInk = dark ? scheme.TextOnInfo : scheme.TextPrimary;

        return $":root{{"
            + $"color-scheme:{(dark ? "dark" : "light")};"
            + $"--ns-accent-ink:{scheme.AccentInk};"
            + $"--ns-accent-on-chrome:{scheme.AccentOnChrome};"
            + $"--ns-elevation-ring:{elevationRing};"
            + $"--ns-alert-info-bg:{alertInfoBg};"
            + $"--ns-alert-info-border:{alertInfoBorder};"
            + $"--ns-alert-info-ink:{alertInfoInk};"
            + "}";
    }

    // The one place a Brand's typeface becomes loadable: BrandMudTheme already put its name on
    // Typography.H1-H6, and the browser still needs to be told where that family's bytes are.
    // Typefaces.AssetPath is the one convention both this and a PDF embedder read the file at,
    // so a pick travels as a key and never a URL.
    static string FontFace(string? typefaceKey)
    {
        var typeface = Typefaces.Find(typefaceKey);

        if (typeface is null)
        {
            return string.Empty;
        }

        var family = typeface.FontFamily[0];
        var url = Typefaces.AssetPath(typeface.Key);

        return $"@font-face{{font-family:'{family}';src:url('{url}') format('truetype');font-display:swap;}}";
    }

    /// <summary>The colourless grey a surface wears when no brand is known — the last resort,
    /// never a default a caller can mistake for an answer.</summary>
    internal static Brand Neutral()
    {
        var brand = new Brand();

        Shade(brand.Dark, "#8a8782", "#989591", "#777470", "#adaba8");
        Shade(brand.Light, "#75726d", "#86837f", "#65625e", "#9e9c99");

        return brand;
    }

    static void Shade(BrandTheme theme, string accent, string hover, string pressed, string focus)
    {
        theme.Accent = accent;
        theme.AccentHover = hover;
        theme.AccentPressed = pressed;
        theme.AccentFocus = focus;
        theme.TextOnAccent = "#ffffff";
    }
}
