@namespace NSail.Components
@using NSail.Localization

@inject StringManager Strings

@* Nothing to close on the default surface (the main page): the control removes itself. *@
@if (Surface is not null && !Surface.IsMain)
{
    @* The header X is the house's one button at the flat rank with no word to draw, drawn by
       NsButton like every other glyph in the chrome rather than by a second icon button of
       its own. *@
    @if (As == NsAs.Inline)
    {
        <NsButton As="NsAs.Inline"
                  Breakpoint="NsBreakpoint.Never"
                  Icon="@NsIcons.Close"
                  Label="@Strings.Translate("Common.Close")"
                  Chord="@NsKeys.Close"
                  Disabled="@ParentDisabled"
                  OnClick="@(() => Surface.Close())"
                  Class="@Class" />
    }
    else
    {
        @* Ripple: a refused face answers a press with nothing (the note in NsButton). *@
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="@ParentDisabled"
                   Ripple="@(!ParentDisabled)"
                   OnClick="@(() => Surface.Close())"
                   Class="@Class"
                   UserAttributes="_keys">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Strings.Translate("Common.Close")
            }
        </MudButton>
    }
}

@code {

    // Rebuilt only when the claim changes: a fresh dictionary every render reads as a changed
    // parameter on the vendor button (NsKeys.Declare). Esc is always claimed, so the chord's
    // own hint rides in beside it the one time the word is known as text — ChildContent null,
    // the default "Cancelar"; Label passed beside a custom one.
    Dictionary<string, object> _keys = NsKeys.Declare(NsKeys.Close);

    string? _chordHint;

    [CascadingParameter]
    SurfaceContext? Surface { get; set; }

    /// <summary>What the form around this control refuses — Disabled, or the freeze a running
    /// submit puts on every field under it. Read here rather than left to the two faces, because
    /// where both stand in the same cascade they have to answer it together: the header X is an
    /// NsButton, which decides for itself, and the worded one is a vendor button reading the same
    /// cascade on its own terms (ui/actions.md) — without this the X stays live over a Cancelar
    /// that has gone grey, one way out of a surface disagreeing with the other.
    /// <para>A DIALOG's X stands outside that cascade — NsOpenDialog draws it in TitleContent, which
    /// MudDialog renders in the provider's tree, above the hosted component and the NsForm inside it
    /// — and reads this same name all the same: the form's word travels up through the surface
    /// (SurfaceContext.FormRefuses) and NsDialogExit re-provides it there. So nothing here knows
    /// which surface it is on, and both faces answer on every one of them.</para></summary>
    [CascadingParameter(Name = "ParentDisabled")]
    bool ParentDisabled { get; set; }

    /// <summary>Rank only: default is the footer's worded button ("Cancelar"); Inline — the
    /// flat rung with nothing to word — is the header's X.</summary>
    [Parameter]
    public NsAs As { get; set; } = NsAs.Default;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The act's word as a string — set it beside a custom ChildContent so the Esc
    /// tooltip can restate it; ChildContent itself cannot, being a RenderFragment rather than
    /// text. Unused when ChildContent is null: the default word is Strings' own string
    /// already.</summary>
    [Parameter]
    public string? Label { get; set; }

    // The word the tooltip restates: Label where a custom ChildContent handed one over,
    // Strings' own default where there is no ChildContent to restate at all. Null means the
    // word is not known as text.
    string? GetWord()
    {
        if (Label is { Length: > 0 })
        {
            return Label;
        }

        return ChildContent is null ? Strings.Translate("Common.Close") : null;
    }

    protected override void OnParametersSet()
    {
        var word = GetWord();
        var chordHint = word is { Length: > 0 } ? $"{word} ({NsKeys.Close})" : null;

        if (_chordHint == chordHint)
        {
            return;
        }

        _chordHint = chordHint;

        // aria-label pinned to the bare word keeps the accessible name the word (nsail#2259):
        // the key is a decoration, and a decoration joining the name is the defect whether it
        // is drawn beside it or written into it. data-ns-whisper is a different attribute the
        // name computation never reads, and it carries the longer string the bubble shows
        // (THE WHISPER, ns-mud.css).
        _keys = chordHint is null
            ? NsKeys.Declare(NsKeys.Close)
            : new Dictionary<string, object>(NsKeys.Declare(NsKeys.Close))
            {
                ["aria-label"] = word!,
                ["data-ns-whisper"] = chordHint,
            };
    }
}
