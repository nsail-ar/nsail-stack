@namespace NSail.Components
@using NSail.Localization
@implements IDisposable

@inject StringManager Strings

@{
    var icon = GetIcon();
}

<MudButton ButtonType="ButtonType.Submit"
           Variant="Variant.Filled"
           Color="@(As == NsAs.Filter ? Color.Default : Color.Primary)"
           StartIcon="@(icon.Markup)"
           Disabled="@GetDisabled()"
           Class="@GetClasses(icon)"
           UserAttributes="_keys">
    <span class="@NsResponsive.LabelClasses(icon, Breakpoint)">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Strings.Translate(As == NsAs.Filter ? "Common.Filter" : "Common.Submit")
        }
    </span>
</MudButton>

@code {

    // What this button claims, rebuilt only when the claim changes: a fresh dictionary every
    // render reads as a changed parameter on the vendor button (NsKeys.Declare).
    Dictionary<string, object> _keys = [];

    string? _claimed;

    string? _chordHint;

    [CascadingParameter]
    SurfaceContext? Surface { get; set; }

    /// <summary>Cascaded by NsForm: false for Untracked forms (filters, sign-in), whose
    /// submit never waits for changes.</summary>
    [CascadingParameter(Name = "FormTracked")]
    bool? FormTracked { get; set; }

    /// <summary>Cascaded by NsForm while its own submit handler runs — the button cannot
    /// track this itself, the form owns the run.</summary>
    [CascadingParameter(Name = "FormRunning")]
    bool FormRunning { get; set; }

    /// <summary>Chrome only: default is the form's hero (filled Primary); Filter is the
    /// quiet search-bar submit; Send keeps the hero's chrome but carries the paper-airplane
    /// glyph, for a submit whose act is sending words rather than saving a document — write it
    /// in full (<c>NsAs.Send</c>): a page's own <c>Send</c> (NsPartial) hides the bare
    /// name.</summary>
    [Parameter]
    public NsAs As { get; set; } = NsAs.Submit;

    /// <summary>Container width from which the label shows next to the icon; below it the
    /// button collapses to the icon alone. Always (the default) pins the label on. Same
    /// meaning as on NsButton, but the default is the opposite: a footer submit is the one
    /// control that must never be a guess, and the surfaces it lives in are narrow enough
    /// that any other default would collapse it always — a 480px aside never reaches the
    /// 600px the sm container query asks for.
    /// <para>Anything but Always is out until this button has a name it can restate: its word
    /// is ChildContent by default, a RenderFragment and not a string, so unless <see
    /// cref="Label"/> gives the word as text, it writes no aria-label — the attribute the
    /// collapsed control's accessible name reads once its own text goes display:none. A
    /// collapsed submit would say nothing.</para></summary>
    [Parameter]
    public NsBreakpoint Breakpoint { get; set; } = NsBreakpoint.Always;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The act's word as a string — set it beside a custom ChildContent (Presupuestar,
    /// Recibir) so the chord tooltip can restate it; ChildContent itself cannot, being a
    /// RenderFragment rather than text. Unused when ChildContent is null: the default word is
    /// Strings' own string already.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Same word as NsForm's own knob, same idea: a transition (Entregar, Revisar,
    /// any confirm-shaped door) is an act, not an edit — its hero has nothing to wait on, so
    /// it stays enabled from arrival even inside a form that otherwise tracks changes.</summary>
    [Parameter]
    public bool Untracked { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The icon is the state: a tick to confirm (pairing with the cross NsClose sits next to
    // in the same footer), the search that applies a filter, and the spinner while the
    // form's own handler runs — which is also what the button collapses to when the label
    // gives way, so a busy narrow button still says something.
    Glyph GetIcon()
    {
        if (FormRunning)
        {
            return NsIcons.Progress;
        }

        return As switch
        {
            NsAs.Filter => NsIcons.Search,
            NsAs.Send => NsIcons.Send,
            _ => NsIcons.Check,
        };
    }

    string GetClasses(Glyph icon)
    {
        return new NsClassBuilder(NsResponsive.CollapseClass(icon, Breakpoint))
            // The chord's own whisper (ns-mud.css, THE WHISPER): ungated, so it stands beside
            // the label whether or not Breakpoint ever collapses it.
            .Add("ns-chord", _chordHint is not null)
            .Add(Class)
            .ToString();
    }

    // The word the tooltip restates: Label where a custom ChildContent handed one over,
    // Strings' own default where there is no ChildContent to restate at all. Null means the
    // word is not known as text, which is Label's own doc comment.
    string? GetWord()
    {
        if (Label is { Length: > 0 })
        {
            return Label;
        }

        return ChildContent is null
            ? Strings.Translate(As == NsAs.Filter ? "Common.Filter" : "Common.Submit")
            : null;
    }

    protected override void OnInitialized()
    {
        if (Surface is not null)
        {
            Surface.StateChanged += OnSurfaceStateChanged;
        }
    }

    // Ctrl+Enter on every hero and Ctrl+S beside it only where there is a document to save:
    // the form that tracks changes is the one holding one, and a filter or a sign-in has
    // nothing the desktop habit would mean. A filter's submit claims neither — the chord names
    // the form's act, and that button is not it.
    protected override void OnParametersSet()
    {
        Dictionary<string, object> chords = As == NsAs.Filter
            ? []
            : NsKeys.Declare(NsKeys.Submit, FormTracked == true ? NsKeys.Save : null);

        var claimed = chords.Count == 0 ? null : (string)chords[NsKeys.Attribute];

        // Read off the claim itself rather than named a second time: the tooltip reads the
        // first chord of what this button actually publishes, so the key shown cannot come to
        // differ from the key dispatched.
        var hint = claimed?.Split(' ')[0];
        var word = hint is null ? null : GetWord() is { Length: > 0 } known ? known : null;
        var chordHint = word is null ? null : $"{word} ({hint})";

        if (_claimed == claimed && _chordHint == chordHint)
        {
            return;
        }

        _claimed = claimed;
        _chordHint = chordHint;

        // Generated content on a control joins its accessible name UNLESS aria-label is there
        // to outrank it (nsail#2259, THE WHISPER) — this button carries none today, its word
        // being on-screen text, so ns-chord's own ::after would join "Guardar" into "Guardar
        // (Ctrl+Enter)" the moment it draws one. aria-label pinned to the bare word is what
        // keeps the name the word while data-ns-chord, a different attribute the name
        // computation never reads, carries the longer string the bubble shows.
        _keys = chordHint is null
            ? chords
            : new Dictionary<string, object>(chords) { ["aria-label"] = word!, ["data-ns-chord"] = chordHint };
    }

    // Nothing to save yet: a tracked form's submit stays greyed out until the surface
    // reports changes. Untracked forms (FormTracked false) always submit.
    bool GetDisabled()
    {
        if (Disabled)
        {
            return true;
        }

        // A tracked form is already covered — HandleSubmit clears the changes before it
        // raises — but an untracked one (sign-in, filters) would otherwise submit again
        // on every click while the first one is still in flight.
        if (FormRunning)
        {
            return true;
        }

        if (!Untracked && FormTracked == true && Surface is not null)
        {
            return !Surface.HasChanges;
        }

        return false;
    }

    void OnSurfaceStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (Surface is not null)
        {
            Surface.StateChanged -= OnSurfaceStateChanged;
        }
    }
}
