@namespace NSail.Components

@* The chord a control answers, drawn ON the control, so the keyboard is learned from the
   screen and never from a manual. aria-hidden because the control publishes the same claim
   where it is read rather than seen (NsKeys writes aria-keyshortcuts beside the house's own
   attribute): without it a screen reader says the key twice. *@
<kbd class="@GetClasses()" aria-hidden="true">@Chord</kbd>

@code {

    /// <summary>The one chord to draw. A control answering two draws its first — the badge is
    /// a reminder on the way past, not the reference, and the reference is the sheet "?"
    /// opens.</summary>
    [Parameter, EditorRequired]
    public string Chord { get; set; } = string.Empty;

    // The label's own rule, one breakpoint later than nothing: a surface too narrow for the
    // button's word has no room for a hint beside it either. The touch screens the badge is
    // also wrong on are the stylesheet's half of this (ns-mud.css, THE KEY ON THE BUTTON) —
    // a pointer is not a width and no class can ask about one.
    static string GetClasses()
    {
        return new NsClassBuilder("ns-key")
            .Add(NsResponsive.ShownFromContainer(NsSize.Sm))
            .ToString();
    }
}
