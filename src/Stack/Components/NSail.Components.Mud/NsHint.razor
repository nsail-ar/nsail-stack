@namespace NSail.Components
@implements IAsyncDisposable

@* NsHelp's own mechanism — an icon that carries a paragraph nothing else on the
   row has room for, unloaded from the document until asked for, dismissed the same three ways
   — generalized for a caller whose text is not one fixed translation key: a per-row fact
   ("Solo quedan {0} en stock") that changes with the data, and an icon that
   is not always the Help glyph. NsHelp keeps its own single-parameter contract (its own test
   guards it); this is the sibling for everyone else. *@
<span class="ns-help d-inline-flex align-center @Class" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="_open">
    <NsButton As="@NsAs.Inline" Breakpoint="NsBreakpoint.Never"
              Icon="@Icon"
              Size="@NsSize.Sm"
              Label="@Text"
              Expanded="_open"
              OnClick="Toggle" />

    @if (_open)
    {
        <MudPopover Open="true"
                    AnchorOrigin="@Origin.BottomLeft"
                    TransformOrigin="@Origin.TopLeft"
                    Style="@($"z-index:{SurfaceContext.VendorZIndex}")"
                    Class="ns-help-popover">
            <div class="ns-help-text">@Text</div>
        </MudPopover>

        <MudOverlay Visible="true"
                    LockScroll="false"
                    ZIndex="@(SurfaceContext.VendorZIndex - 1)"
                    OnClick="Close" />
    }
</span>

@code {

    bool _open;

    [CascadingParameter]
    EscapeHolds? Holds { get; set; }

    [Parameter, EditorRequired]
    public Glyph Icon { get; set; }

    /// <summary>Already resolved — the button's own accessible name/tooltip and the popover's
    /// body are the same string, because a fact worth a click is worth saying in full on
    /// hover too.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    void Toggle()
    {
        _open = !_open;
    }

    void Close()
    {
        _open = false;
    }

    // Closes on the next turn (ui/menus.md, "The innermost open thing wins Escape").
    async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (!_open)
        {
            return;
        }

        if (args.Key == "Escape")
        {
            await Task.Yield();
            Close();
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return Holds?.Set(this, _open) ?? Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (Holds is not null)
        {
            await Holds.Set(this, false);
        }
    }
}
