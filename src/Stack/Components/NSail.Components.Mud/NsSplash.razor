@namespace NSail.Components
@using System.Text.Json
@using NSail.Icons
@using NSail.Localization

@inject StringManager Strings

<div id="ns-splash" class="fixed inset-0 z-max d-flex flex-column align-center justify-center pa-6 bg-background">

    <div class="d-flex flex-column align-center gap-4 ns-brand-column">

        @* The install's name sets the width of the whole block -- the script below measures the
           name's own single-line width the moment it arrives and writes it here as this box's
           width, so the logo (width:100%) and the bar track it in lockstep rather than each
           reaching its own. The 200px floor is what the box sizes against before that measurement
           lands -- the no-logo, name-not-arrived-yet moment -- and max-width:100% is the ceiling a
           long name or a narrow phone falls back on: the script writes a width past it freely, and
           this is what clips it back down, wrapping the name along with it (no JS needed for that
           half).

           #8a8782 below is the CSS fallback for --mud-palette-primary, painted only until
           MudThemeProvider sets the real variable -- a WASM boot's very first frame has no
           theme yet, so this literal is what the eye actually sees for an instant. It matches
           NsTheme's own Neutral() grey (NsSetupBrandTests.NeutralDark), never a brand's
           colour: a fallback that guesses would flash the wrong one on every install but the
           one it guessed right. *@
        <div id="ns-splash-block" class="d-flex flex-column align-center gap-4" style="width:200px; max-width:100%;">
            @if (LogoUrl is not null)
            {
                @* width:100%, not a fixed height: the mark takes whatever width the name leaves
                   it (never more -- the block's own width is the name's, not the logo's) and
                   keeps its own ratio under that width, the way a wide lockup always has.
                   height:auto is what lets the aspect ratio answer instead of a number this
                   markup would have to guess; object-fit:contain is the same belt the <img>
                   fallback already wore, kept in case something past this box ever gives it a
                   height too.

                   aspect-ratio:auto 1/1 is the height this band draws BEFORE the file's own
                   bytes decode: auto prefers the file's real ratio the moment the browser knows
                   it, and 1/1 is what it falls back to the instant before that, a square guess
                   rather than the zero height an unconstrained height:auto leaves it -- without
                   it the name, the bar and the percentage line below all drop the moment the
                   logo answers, content moving for a state that carries no information. A wide
                   lockup still corrects once its real ratio is known: one resize, not the two a
                   bare height:auto draws. *@
                <div id="ns-splash-logo" data-logo="@LogoUrl" data-dark-logo="@DarkLogoUrl"
                     style="width:100%; color:var(--mud-palette-primary, #8a8782);">
                    @* The first frame, before the inlined mark replaces it: the OS scheme picks the
                       file here, and the script below picks by the ground the splash is actually
                       painted on once it has measured it. *@
                    <picture>
                        @if (DarkLogoUrl is not null)
                        {
                            <source media="(prefers-color-scheme: dark)" srcset="@DarkLogoUrl" />
                        }
                        <img src="@LogoUrl" alt="" style="width:100%; height:auto; max-width:100%; aspect-ratio:auto 1 / 1; object-fit:contain;"
                             onerror="this.style.display='none'; this.closest('#ns-splash-logo').dataset.failed='1';" />
                    </picture>
                </div>
            }

            @* Populated by the script below from the same anonymous branding read the logo
               inlining uses -- stays display:none until the name arrives so there is no empty
               gap while the fetch is in flight. width:100% (rather than the shrink-to-fit this
               flex column gives every other child) is what lets the text wrap inside the
               measured width instead of pushing the box open to its own single line. *@
            <div id="ns-splash-name" data-brand-url="@BrandUrl"
                 style="display:none; width:100%; text-align:center; color:var(--mud-palette-text-primary, #ececea); font-size:1.25rem; font-weight:500; line-height:1.3;">
            </div>

            <div class="ns-splash-track rounded-pill overflow-hidden" style="width:100%; height:5px; background:rgba(128,128,128,.24);">
                <div class="rounded-pill"
                     style="
                        width:var(--blazor-load-percentage, 0%);
                        height:5px;
                        background:var(--mud-palette-primary, #8a8782);
                        transition:width 350ms ease-out;
                        ">
                </div>
            </div>

            @* Centred under the bar and bound to the same width as everything else in the block
               (width:100%, same reason as the name above) -- a long percentage line wraps
               rather than stretching the block a fourth width of its own. *@
            <div style="width:100%; text-align:center; color:var(--mud-palette-text-secondary, #b3b0ab); font-size:0.875rem;">
                @Strings.Translate("Common.Loading") <span class="ns-splash-percent"></span>
            </div>
        </div>

    </div>

</div>

<script>
    // The name's own single-line width, measured off a throwaway probe rather than off the
    // visible element: ns-splash-name is already width:100% of the block this figure is about
    // to size, so reading its OWN box back would read whatever width the block happened to have
    // a moment ago, not what the name's text actually asks for. nowrap on the probe is what
    // makes that width independent of how narrow the real element currently is -- a long name
    // that has not been capped yet still measures as one line.
    function measureNaturalWidth(text, styleSource) {
        const probe = document.createElement("div");
        const style = getComputedStyle(styleSource);

        probe.style.position = "absolute";
        probe.style.visibility = "hidden";
        probe.style.whiteSpace = "nowrap";
        probe.style.left = "-9999px";
        probe.style.top = "-9999px";
        probe.style.fontSize = style.fontSize;
        probe.style.fontWeight = style.fontWeight;
        probe.style.fontFamily = style.fontFamily;
        probe.textContent = text;

        document.body.appendChild(probe);

        const width = probe.getBoundingClientRect().width;

        probe.remove();

        return width;
    }

    (function () {
        const nameEl = document.getElementById("ns-splash-name");
        const block = document.getElementById("ns-splash-block");

        if (!nameEl || !nameEl.dataset.brandUrl)
            return;

        // Same anonymous, pre-session route family as the logo:
        // reachable before WASM boots or any org is known from a cookie session.
        fetch(nameEl.dataset.brandUrl, { credentials: "same-origin" })
            .then(response => response.ok ? response.json() : null)
            .then(data => {
                if (!data || !data.name)
                    return;

                nameEl.textContent = data.name;
                nameEl.style.display = "";

                // The width this writes is what ns-splash-block's own max-width:100% then caps
                // for a long name or a narrow phone -- the CSS ceiling takes it from here, and
                // the name (width:100%, no nowrap) wraps under whatever that ceiling leaves it.
                if (block) {
                    block.style.width = `${Math.ceil(measureNaturalWidth(data.name, nameEl))}px`;
                }
            })
            .catch(() => { });
    })();

    // The mark is chosen by the ground the splash is painted on, read back from its own
    // background: the theme variables are the same ones the page then wears, so the mark and the
    // ground cannot disagree. The OS scheme answers only where nothing is painted yet.
    function logoUrl(host) {
        const dark = host.dataset.darkLogo && splashIsDark();

        return dark ? host.dataset.darkLogo : host.dataset.logo;
    }

    function splashIsDark() {
        const splash = document.getElementById("ns-splash");
        const channels = splash ? getComputedStyle(splash).backgroundColor.match(/[d.]+/g) : null;

        if (channels && channels.length >= 3 && !(channels.length > 3 && Number(channels[3]) === 0)) {
            const [r, g, b] = channels.map(Number);

            return 0.2126 * r + 0.7152 * g + 0.0722 * b < 128;
        }

        return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    // The same allowlist SvgSanitizer applies on the C# side, injected from it, so the logo
    // route's bytes never reach the DOM as markup: they are parsed, filtered node by node and
    // only the survivors are adopted.
    const svgElements = new Set(@((MarkupString)ToJson(SvgSanitizer.AllowedElements)));
    const svgTextElements = new Set(@((MarkupString)ToJson(SvgSanitizer.AllowedTextElements)));
    const svgAttributes = new Set(@((MarkupString)ToJson(SvgSanitizer.AllowedAttributes)));

    function cleanSvg(source) {
        const doc = new DOMParser().parseFromString(source, "image/svg+xml");
        const root = doc.documentElement;

        if (!root || root.localName.toLowerCase() !== "svg" || doc.getElementsByTagName("parsererror").length)
            return null;

        return cleanNode(root);
    }

    function localUrls(value) {
        return [...value.matchAll(/url\(\s*['"]?\s*([^)'"\s]*)/gi)].every(m => m[1].startsWith("#"));
    }

    function cleanNode(node) {
        if (node.namespaceURI !== "http://www.w3.org/2000/svg" || !svgElements.has(node.localName.toLowerCase()))
            return null;

        const copy = document.createElementNS("http://www.w3.org/2000/svg", node.localName);

        for (const attr of node.attributes) {
            const value = attr.value;

            if (attr.name.startsWith("xmlns") || !(svgAttributes.has(attr.name.toLowerCase()) || attr.name.toLowerCase().startsWith("data-")))
                continue;

            if (attr.localName === "href" ? !value.startsWith("#") : /javascript:|data:/i.test(value) || !localUrls(value))
                continue;

            copy.setAttribute(attr.name, value);
        }

        const textual = svgTextElements.has(node.localName.toLowerCase());

        for (const child of node.childNodes) {
            if (child.nodeType === Node.TEXT_NODE && textual) {
                copy.appendChild(document.createTextNode(child.nodeValue));
            } else if (child.nodeType === Node.ELEMENT_NODE) {
                const clean = cleanNode(child);

                if (clean)
                    copy.appendChild(clean);
            }
        }

        return copy;
    }

    (function () {
        const host = document.getElementById("ns-splash-logo");

        if (!host)
            return;

        // An <img> is its own document and cannot inherit the colour around it, so an SVG
        // logo drawn with currentColor renders black. Inlining is the only way it takes the
        // primary the container carries -- and only an SVG is inlined, so a raster logo keeps
        // its own baked colours through the <img> that is already here. Sized the same as the
        // <img> fallback above (the block's own width, height following the ratio), then fitted
        // to its artwork in this same task so the block lays out once.
        fetch(logoUrl(host), { credentials: "same-origin" })
            .then(response => {
                const type = (response.headers.get("content-type") || "").split(";")[0].trim();

                return response.ok && type === "image/svg+xml" ? response.text() : null;
            })
            .then(svg => {
                if (!svg)
                    return;

                const root = cleanSvg(svg);

                if (!root)
                    return;

                host.replaceChildren(root);

                root.style.width = "100%";
                root.style.height = "auto";
                root.style.maxWidth = "100%";
                // An inline svg sits on the line box's baseline and adds the descender gap
                // under the mark; a block has none, so the block's own gap is all that is left.
                root.style.display = "block";
                // Same fallback as the <img> this replaces, kept here too for an SVG
                // with no viewBox of its own to give the browser a ratio before this.
                root.style.aspectRatio = "auto 1 / 1";

                // In the same task as the inlining, so the one layout the browser draws
                // is already the artwork's own: the band under the mark is the block's
                // gap and nothing else, and the fit adds no second resize.
                window.nsapp.fitMark(root);
            })
            .catch(() => { });
    })();

    window.nsapp.onAppReady(() => {
        const el = document.getElementById("ns-splash");

        if (!el)
            return;

        el.style.transition = "opacity 350ms ease";
        el.style.opacity = "0";

        setTimeout(() => el.remove(), 350);
    }, { once: true });
</script>

@code {
    static string ToJson(IEnumerable<string> names)
    {
        return JsonSerializer.Serialize(names.Select(n => n.ToLowerInvariant()));
    }

    /// <summary>The app's own well-known logo route (for example an anonymous
    /// "api/branding/logo", reachable before WASM boots and before any session
    /// exists) — a plain string, no coupling, and no default: a Stack component names no
    /// app-specific URL. An SVG response is inlined so it can inherit the splash's primary
    /// colour, which first passes the <see cref="SvgSanitizer"/> allowlist; anything else stays an isolated
    /// <c>&lt;img&gt;</c>.</summary>
    [Parameter]
    public string? LogoUrl { get; set; }

    /// <summary>The same mark for a dark ground, where the brand has one: the splash wears it
    /// when its own background is dark. Same route family and same sanitized-SVG rule as
    /// <see cref="LogoUrl"/>; unset, the one logo serves both grounds.</summary>
    [Parameter]
    public string? DarkLogoUrl { get; set; }

    /// <summary>The app's anonymous branding-info route (for example
    /// "api/branding/public") — read only for its <c>Name</c>, rendered under the logo (or
    /// alone, when there is none). Same no-coupling shape as <see cref="LogoUrl"/>: a plain
    /// string, no app-specific default.</summary>
    [Parameter]
    public string? BrandUrl { get; set; }
}
