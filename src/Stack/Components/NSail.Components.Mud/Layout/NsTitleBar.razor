@namespace NSail.Components
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using NSail.Localization
@implements IDisposable

@inject StringManager Strings
@inject NavMenu Menu
@inject RouteTable Routes
@inject NavigationManager Navigation

@* On the main surface the shell has no bar at all (nsail#561), so this row IS the screen's
   title at every width — the title belongs to the page, not to a global frame. The one thing
   the vanished bar owned that no page can own is the way to reach a hidden drawer, so the
   hamburger lives here, at the head of the title row and only at the widths the drawer is not
   docked at — and once per screen, however many title rows the screen draws: the surface hands
   it to the first row that asks (SurfaceContext.ClaimsRow), so a panel that is a section of
   the screen rather than its subject gets no second hamburger. The X belongs to an overlay:
   there is nothing to close on the surface the app is already at. *@
@* And where the SHELL draws this surface's row (NsSurfaceChrome, inside NsDrawer and NsDialog),
   the screen's own row draws nothing at all and only announces: the chrome of an overlay has to
   stand from the first frame, and this row is drawn inside the page's NsForm, which renders
   neither of its branches until its first read answers (nsail#2053). What goes quiet is the
   row that claimed the surface — a section's row is still the section's and still draws. *@
@* THE PAGE NAME NEVER GIVES WAY (nsail#1869). The title and the utilities beside it are two
   boxes in one row, and when the row runs short the row WRAPS: the utilities take a line of
   their own — still at the trailing edge, which ms-auto holds for them once space-between has
   no second box left to push against — and the title keeps its own content width. Hence no
   min-w-0 on either box and no text-truncate on the title: a flex item with a zero floor
   shrinks to nothing before a row ever considers wrapping, which hands the heading's word to
   the icon boxes beside it. Both faces below carry the rule, and the wrap costs the row
   nothing where both boxes already fit. *@
@if (OnMain)
{
    <NsStack Horizontal Wrap Align="NsAlign.Center" Justify="NsAlign.SpaceBetween">
        <div class="d-flex align-center">
            @if (OwnsToggle)
            {
                <span class="@GetToggleClasses()">
                    @* This row is drawn inside whatever a page wrapped its panel in, and that is
                       usually an NsForm — whose ParentDisabled cascade MudBaseButton reads for
                       itself. The drawer is the SHELL's, not the form's: reaching the menu writes
                       nothing and a save it has no part in must not take it away, so the vendor
                       is answered here and never asked (ui/actions.md, the vendor is not a second
                       opinion). *@
                    <CascadingValue Value="false" Name="ParentDisabled" IsFixed="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                       Edge="Edge.Start"
                                       Color="Color.Inherit"
                                       aria-label="@Strings.Translate("Common.Menu")"
                                       OnClick="LayoutState!.ToggleDrawer" />
                    </CascadingValue>
                </span>
            }
            <NsStack Horizontal Gap="NsSize.Xs" Align="NsAlign.Center">
                @* The page's glyph and the loading indicator share ONE slot, never two — see the
                   twin block below for why, and ns-title-icon-slot (ns-mud.css) for how the slot
                   keeps its box whether an icon is in it or not (nsail#614). *@
                <span class="ns-title-icon-slot">
                    @if (Surface?.HasWork == true)
                    {
                        <NsIcon Icon="@NsIcons.Progress" Title="@Strings.Translate("Common.Loading")" />
                    }
                    else if (GetIcon() is { } icon)
                    {
                        <NsIcon Icon="@icon" />
                    }
                </span>
                <NsText As="NsTextAs.Title">@Title</NsText>
            </NsStack>
        </div>
        <NsStack Horizontal Gap="NsSize.Xs" Align="NsAlign.Center" Class="ms-auto">
            @ChildContent
        </NsStack>
    </NsStack>
}
else if (!Hoisted)
{
    <NsStack Horizontal Wrap Align="NsAlign.Center" Justify="NsAlign.SpaceBetween">
        <NsStack Horizontal Gap="NsSize.Xs" Align="NsAlign.Center">
            @* The page's glyph and the loading indicator share ONE slot, never two: while the
               surface has work the icon IS the spinner, and the glyph returns when it ends. An
               indicator appended after the title is a third element arriving and leaving inside a
               row that is supposed to be still, and geometry is reserved, never moved — the span's
               own ns-title-icon-slot (ns-mud.css) fixes the box, never the content that fills it.
               A page with no glyph of its own lends the same empty slot for the duration, spinner
               included: nothing about the box itself ever changes. *@
            <span class="ns-title-icon-slot">
                @if (Surface?.HasWork == true)
                {
                    <NsIcon Icon="@NsIcons.Progress" Title="@Strings.Translate("Common.Loading")" />
                }
                else if (GetIcon() is { } icon)
                {
                    <NsIcon Icon="@icon" />
                }
            </span>
            <NsText As="NsTextAs.Title">@Title</NsText>
        </NsStack>
        <NsStack Horizontal Gap="NsSize.Xs" Align="NsAlign.Center" Class="ms-auto">
            @ChildContent
            <NsClose As="NsAs.Inline" />
        </NsStack>
    </NsStack>
}

@code {

    Glyph? _derivedIcon;
    bool _resolved;

    /// <summary>The panel's title row: title on the left, actions then the close icon on
    /// the right. Goes inside NsPanel/NsCard's Header slot — not inside page content,
    /// where the close icon would offer to close the surface from the middle of a form.
    /// On the main surface it draws the drawer's toggle where the close icon would be, since
    /// the shell has no bar of its own — the screen's first row draws it and a second row none —
    /// and inside a host that draws this surface's chrome itself it draws nothing. Either way it
    /// announces the title and the actions to its surface (SurfaceContext.Announce), which is
    /// what lets the same bar serve a full page and an overlay without a flag.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Overrides the icon this bar derives from the address the page was opened at:
    /// the menu entry for that address, or the nearest ancestor address that has one — so a
    /// create, an edit or a detail hanging under a list wears the list's glyph without being
    /// given it. Leave unset for the derived one; set it where the page means something the
    /// family's glyph does not say (ClientPage's Person under Clientes' People).</summary>
    [Parameter]
    public Glyph? Icon { get; set; }

    /// <summary>Actions shown before the close icon (New, filters, anything page-specific).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    SurfaceContext? Surface { get; set; }

    // Never read for the user — it is the key NavMenu is asked under, and every consumer of
    // that tree has to hand it the same value or the two take turns discarding each other's
    // answer. The app-wide cascade (AddCascadingAuthenticationState) reaches every bar wherever
    // it is drawn, so "the same value" costs nothing to guarantee.
    [CascadingParameter]
    Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The shell's drawer state, cascaded by NsMainLayout. Absent wherever this bar
    /// draws outside a shell — an overlay's chrome, a test host — and then no toggle is drawn.</summary>
    [CascadingParameter]
    public NsLayoutState? LayoutState { get; set; }

    /// <summary>Set by the host whose shell draws this surface's chrome itself — NsDrawer and
    /// NsDialog, around everything they host. The row this bar would draw is already on screen
    /// before the page rendered, so here the bar only announces.</summary>
    [CascadingParameter(Name = "SurfaceChrome")]
    bool ShellDrawsTheRow { get; set; }

    /// <summary>Whether this bar is on the main surface: it then draws the drawer's toggle
    /// instead of a close icon. An overlay draws its own close — unless the shell drew the row
    /// for it — and so does a bar no surface cascade reached.</summary>
    bool OnMain => Surface?.IsMain == true;

    // This bar's row is the shell's: it draws nothing and hands the name, the glyph and the
    // utilities over instead. Claimed, so a panel that draws a second title row keeps drawing
    // it — the screen's name is what the shell hoists, not every row the screen has.
    bool Hoisted => ShellDrawsTheRow && Surface is { IsMain: false } && Surface.ClaimsRow(this);

    /// <summary>Whether this bar hands its content to its surface: the main surface's chrome
    /// reader (NsAppBar, for a host that mounts one) and an overlay's row both read it there.</summary>
    bool Announces => OnMain || Hoisted;

    // Whether this SURFACE draws a toggle at all — main surface, drawer cascade present.
    // NsPageHeader's toolbar row reserves the same gutter beneath this one's, so it calls
    // this predicate too rather than re-deriving it: two rows agreeing by construction,
    // never by two hand-written conditions staying in sync. The page header composes the row
    // that reserves that gutter and is the page's first, so the claim below is its own.
    internal static bool ShowsToggle(SurfaceContext? surface, NsLayoutState? layoutState)
    {
        return surface?.IsMain == true && layoutState is not null;
    }

    // Asked at render, never cached: the row that holds the claim can leave while the surface
    // stays, and the taker is then whichever row renders next (SurfaceContext.ClaimsRow).
    bool OwnsToggle => ShowsToggle(Surface, LayoutState) && Surface!.ClaimsRow(this);

    protected override void OnInitialized()
    {
        if (Surface is not null)
        {
            Surface.StateChanged += OnSurfaceStateChanged;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_resolved && Icon is null)
        {
            _derivedIcon = await ResolveIcon();
            _resolved = true;
        }

        if (Announces)
        {
            Surface!.Announce(Title, GetIcon(), ChildContent);
        }
    }

    // Whether the drawer is docked or behind a hamburger is a window fact, the vendor's own
    // Breakpoint.Md, and this toggle is chrome standing in for the drawer exactly where the
    // drawer is hidden — the one pair allowed to decide by window width.
    string GetToggleClasses()
    {
        return new NsClassBuilder(NsResponsive.ShownBelowWindow(NsSize.Md))
            .Add("align-center")
            .ToString();
    }

    // Only one caller (NsPageHeader) forwards an override, so the derivation itself lives
    // here once instead of being duplicated at every place a title bar is used.
    Glyph? GetIcon()
    {
        return Icon ?? _derivedIcon;
    }

    async Task<Glyph?> ResolveIcon()
    {
        // A named surface (aside, modal) keeps its own route in a query parameter, not in
        // the browser's path — that path still names the surface underneath it, so reading
        // it directly here would derive the icon of the page behind this one.
        var path = Surface is { IsMain: false, Name: { } name }
            ? SurfaceQuery.GetRoute(Navigation, name)
            : Navigation.ToBaseRelativePath(Navigation.Uri);

        if (path is null)
        {
            return null;
        }

        // A create, an edit and a detail hang UNDER the list they are reached from and have no
        // door of their own, so the glyph is the nearest ancestor address that has one — the
        // walk is NavMenuItem.GlyphFor's, where the route table and the merged tree it reads
        // together both live, rather than a derivation this component owns alone.
        return NavMenuItem.GlyphFor(await Menu.GetItems(AuthenticationState), Routes, path);
    }

    void OnSurfaceStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (Surface is not null)
        {
            Surface.StateChanged -= OnSurfaceStateChanged;
            Surface.ReleaseRow(this);
        }
    }
}
