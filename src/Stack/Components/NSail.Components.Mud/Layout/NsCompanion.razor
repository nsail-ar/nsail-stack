@namespace NSail.Components
@using MudBlazor
@using MudBlazor.Services
@using NSail.Localization

@implements IDisposable

@inject StringManager Strings
@inject Companion Region
@inject DeviceMemory Memory
@inject IBrowserViewportService Viewport

@* The frame's fourth region, drawn: an agent that accompanies while the person works. A
   component of its own and not markup in NsMainLayout, because the services below are the
   region's and not the layout's — a layout that declares no Companion slot renders none of this
   and is asked for neither. The layout is its only composer. *@
@if (Region.IsOpen)
{
    <NsCloseOnEscape Class="@GetClasses()" Closes="Region.Close" Focuses="@_focuses">
        @* Below the drawer's breakpoint the region IS the screen, so it owes a way back: the X is
           drawn there and nowhere else — docked, the page beside it was never covered and the
           door that opened the region is still on screen to close it. *@
        <div class="@GetExitClasses()">
            <NsButton As="NsAs.Inline"
                      Breakpoint="NsBreakpoint.Never"
                      Icon="@NsIcons.Close"
                      Label="@Strings.Translate("Common.Close")"
                      OnClick="Region.Close" />
        </div>

        @ChildContent
    </NsCloseOnEscape>
}

@code {

    bool? _remembered;

    // Whether the NEXT mount of NsCloseOnEscape should take focus: true for a door's own
    // Toggle/Open, false for the one render a silent recall drives (OnAfterRenderAsync below).
    bool _focuses = true;

    // Set the moment anything acts on the region before the recall below resolves — a door
    // pressed while that read is in flight has already decided the region's state, and the
    // recall has nothing left to contribute.
    bool _actedBeforeRecall;

    // True only for the span of the recall's own call to Region.Open() below — OnChanged fires
    // synchronously inside it, and must not mistake its own cause for a door acting afterward.
    bool _recalling;

    // The browser's own key for the one answer this region remembers. Shared on purpose, like
    // every DeviceMemory key: one frame, one companion, one answer.
    const string Key = "ns.companion.open";

    [CascadingParameter]
    NsLayoutState? LayoutState { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Region.Changed += OnChanged;
    }

    // The service is scoped and outlives this component — a sign-out swaps the layout under the
    // same session — so the hook is handed back.
    public void Dispose()
    {
        Region.Changed -= OnChanged;
    }

    // Whoever opened the region is a door somewhere else on screen (the drawer's Tools slot, a
    // page's own act), so the redraw is marshalled rather than called where the state moved.
    void OnChanged()
    {
        _actedBeforeRecall = true;

        if (!_recalling)
        {
            _focuses = true;
        }

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();

            await Remember();
        });
    }

    // Per browser and never per user, which is what DeviceMemory is: whoever sits at that counter
    // gets the counter's answer. Written only when the answer actually moved — a door handing over
    // a second question leaves the region exactly as open as it was.
    async Task Remember()
    {
        if (_remembered == Region.IsOpen)
        {
            return;
        }

        _remembered = Region.IsOpen;

        await Memory.Remember(Key, Region.IsOpen);
    }

    // JS interop cannot run while a page prerenders, so the answer is recalled on the first
    // interactive render. A key never written, a browser that refuses storage or a value that no
    // longer parses all answer false (DeviceMemory), which is the region's own default. A door
    // pressed while either read below is in flight has already decided the region's state —
    // _actedBeforeRecall is checked again after each await, so this never overwrites a text
    // handover or an answer Remember() already wrote with what was merely read before it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var open = await Memory.Recall<bool>(Key);

        if (_actedBeforeRecall)
        {
            return;
        }

        _remembered = open;

        if (!open)
        {
            return;
        }

        // Below the drawer's own breakpoint the region IS the screen, so taking focus costs
        // nothing a person could reach anyway — docked beside the content (NsDrawer's own
        // Md..Xxl), a recall-driven open is silent and the content's own arrival focus is what
        // the cursor belongs to instead.
        var focuses = await Viewport.GetCurrentBreakpointAsync() < Breakpoint.Md;

        if (_actedBeforeRecall)
        {
            return;
        }

        _focuses = focuses;
        _recalling = true;

        Region.Open();

        _recalling = false;
    }

    // ns-no-appbar for the same reason the main content carries it: the bar's height is reserved
    // by a variable, not by the bar, so a layout that mounts no Header would start this region
    // below a gap nothing draws. A bar is assumed where there is no layout to ask (NsDrawer's own
    // default), the geometry of a region that clips being the forgiving one.
    string GetClasses()
    {
        return new NsClassBuilder("ns-companion d-flex flex-column min-h-0")
            .Add("ns-no-appbar", LayoutState?.HasHeader == false)
            .ToString();
    }

    // The way out of a region that is the whole screen, and only there: measured by the WINDOW,
    // the same edge the nav drawer docks or hides on (NsResponsive).
    string GetExitClasses()
    {
        return $"ns-companion-exit justify-end pa-1 {NsResponsive.ShownBelowWindow(NsSize.Md)}";
    }
}
