@namespace NSail.Components

<MudProgressLinear Value="@Percent" Min="0" Max="100" Color="@GetColor()" Size="Size.Large" Rounded="true" Class="@Class" />

@code {

    /// <summary>How much of the allowance is spent. Value and Max are the caller's own units —
    /// the percentage is worked out here so no page does the arithmetic twice, and it is clamped
    /// so a reading past the ceiling still draws a full bar instead of overflowing it.</summary>
    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public double Max { get; set; } = 100;

    /// <summary>The reading's tone: Error for an allowance already spent, Warning for one
    /// nearly spent. None draws the primary accent.</summary>
    [Parameter]
    public NsSeverity? Severity { get; set; }

    [Parameter]
    public string? Class { get; set; }

    double Percent
    {
        get { return Max <= 0 ? 0 : Math.Clamp(Value / Max * 100, 0, 100); }
    }

    Color GetColor()
    {
        return Severity switch
        {
            NsSeverity.Error => Color.Error,
            NsSeverity.Warning => Color.Warning,
            NsSeverity.Success => Color.Success,
            NsSeverity.Info => Color.Info,
            _ => Color.Primary
        };
    }
}
