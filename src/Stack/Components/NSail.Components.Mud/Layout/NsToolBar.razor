@namespace NSail.Components

@* One row of tools above the grid — a flexible child (search Grow or NsSpacer) pushes the
   rest to the right. Used inside NsPageHeader; not meant to stand alone in a page. *@
<NsStack Horizontal Align="NsAlign.Center" Justify="NsAlign.End" Gap="NsSize.Sm" Class="@Class">
    @ChildContent
</NsStack>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
