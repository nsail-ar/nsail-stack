@namespace NSail.Components

@* Read out, not only painted: a refusal that arrives with the page is a block of colour to
   everyone who cannot see it, and the vendor marks none of it. Error and Warning are the tones
   that have to be heard before the person acts, so they carry the same role the house puts on
   the fieldless refusal box (NsForm, NsPanel). Info and Success are copy that sits on the screen
   rather than news, and an aria-live region around static text announces nothing. *@
<MudAlert Severity="@GetSeverity()" Variant="Variant.Filled" Dense="false" Class="@Class"
          role="@(Interrupts ? "alert" : null)">
    @ChildContent
</MudAlert>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public NsSeverity Severity { get; set; } = NsSeverity.Info;

    [Parameter]
    public string? Class { get; set; }

    bool Interrupts => Severity is NsSeverity.Error or NsSeverity.Warning;

    MudBlazor.Severity GetSeverity()
    {
        return Severity switch
        {
            NsSeverity.Error => MudBlazor.Severity.Error,
            NsSeverity.Warning => MudBlazor.Severity.Warning,
            NsSeverity.Success => MudBlazor.Severity.Success,
            _ => MudBlazor.Severity.Info
        };
    }
}
