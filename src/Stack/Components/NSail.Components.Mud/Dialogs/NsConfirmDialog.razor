@namespace NSail.Components
@using NSail.Localization

@inject StringManager Strings

@* The house's own yes/no question, in place of the vendor's message box, for the one thing a
   message box does not offer: WHERE THE CURSOR OPENS. A message box takes its faces as texts and
   nothing else, and wraps them in a focus trap of its own that always lands on the affirmative —
   which over a confirmation that DESTROYS something stands the cursor on the act that destroys,
   where a reflex Enter throws away the document (ui/forms.md, Enter).

   Everything else is the message box's own shape, so the question reads and is pressed the same:
   the title the opener passed (rendered by the dialog itself), the message, and the way out
   before the act that carries the act's own rank and, when it destroys, its own word
   ("Eliminar"/"Cancelar") rather than a bare Sí/No a sentence away from what it answers.

   The cursor is the TRAP's to place and is told where rather than raced: it focuses after any
   gesture this component could make, and taking it back on the next frame is how a FIELD inside a
   dialog has to do it (ns.js, focusFirst) because a field is not a child the trap can be pointed
   at. A button is. What the doctrine warns does not reach the trap is DialogOptions.DefaultFocus,
   which MudDialog never reads — it reads this parameter, and the provider's global as its
   fallback. *@
<MudDialog DefaultFocus="@Opening">
    <DialogContent>
        @Message
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Refuse">@Strings.Translate(RefuseKey)</MudButton>
        <MudButton Color="@AcceptColor" Variant="@AcceptVariant" OnClick="Accept">@Strings.Translate(AcceptKey)</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>Whether the act behind the question destroys something, which is everything this
    /// dialog does differently — where the cursor opens and what the affirmative face wears
    /// (DialogManager.ConfirmDestruction). Derived from the act itself and never asked of a
    /// screen.</summary>
    [Parameter]
    public bool Destroys { get; set; }

    // Which face the cursor opens on, and the reason the two faces are drawn in this order: an
    // ordinary confirmation offers its own act, so the cursor stands on it and Enter takes it;
    // one that destroys stands on the way out, so Enter alone can only decline.
    DefaultFocus Opening
    {
        get { return Destroys ? DefaultFocus.FirstChild : DefaultFocus.LastChild; }
    }

    // The affirmative face's rank: a destructive act is NsAs.Danger, which is error fill — an act
    // is Danger because it DESTROYS something (ui/actions.md) — and an ordinary one keeps the
    // accent a confirmation has always answered with. The vendor's words are NsButton's own
    // mapping of that ladder; the component cannot host an NsButton, whose label is drawn by a
    // container query and a portaled dialog is in no ns-container of ours (NsOpenDialog).
    Color AcceptColor
    {
        get { return Destroys ? Color.Error : Color.Primary; }
    }

    Variant AcceptVariant
    {
        get { return Destroys ? Variant.Filled : Variant.Text; }
    }

    // A destructive question wears the act itself ("Eliminar"), not a bare "Sí" that answers
    // nothing until read beside the sentence above it — the generic word is honest because
    // Destroys is itself derived from the one verb this door is reached through (Delete).
    string AcceptKey
    {
        get { return Destroys ? "Common.Delete" : "Common.Yes"; }
    }

    string RefuseKey
    {
        get { return Destroys ? "Common.Cancel" : "Common.No"; }
    }

    void Accept()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    // A definite no, so a refusal and the ways out that answer nothing — Escape, the backdrop —
    // reach the opener as the same false.
    void Refuse()
    {
        MudDialog.Close(DialogResult.Ok(false));
    }
}
