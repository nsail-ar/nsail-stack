@namespace NSail.Components
@typeparam TSubject

@using Microsoft.AspNetCore.Components.Authorization

@inject IEnumerable<IDashboardContributor<TSubject>> Contributors
@inject PageGate Gate

@* Same one-arrival rule as NsDashboard: nothing renders until the gate has answered. *@
@if (Answered && _items.Count == 0)
{
    @Empty
}
else if (_items.Count > 0)
{
    @* Same owner-of-the-scroll declaration NsDashboard makes, for the same reason: the grid
       is a stretched flex item wherever it is hosted, and a stretched grid sizes its auto
       rows against the height it was handed instead of the height its cards need. *@
    <NsStack Grow Scroll>
        <div class="ns-dashboard">
            @foreach (var item in _items)
            {
                <DynamicComponent @key="item.CardType" Type="item.CardType!" Parameters="@GetParameters(item)" />
            }
        </div>
    </NsStack>
}

@code {

    IReadOnlyList<DashboardItem> _items = [];

    bool _resolved;

    TSubject? _resolvedFor;

    // The gate answers for one subject: while a new one's is pending, the last one's answer
    // must not stand in front of its cards.
    bool Answered => _resolved && EqualityComparer<TSubject?>.Default.Equals(Subject, _resolvedFor);

    /// <summary>What every card on this dashboard is about. Contributors are resolved closed
    /// over its type, so a subject dashboard never collects another one's cards.</summary>
    [Parameter]
    public TSubject? Subject { get; set; }

    /// <summary>What this dashboard shows when the session may open none of the cards
    /// contributed for its subject — the same answer to the permission model NsDashboard's
    /// Empty gives.</summary>
    [Parameter]
    public RenderFragment? Empty { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Subject is null)
        {
            _items = [];
            _resolved = false;
            _resolvedFor = default;
            return;
        }

        var subject = Subject;

        var user = await PageGate.UserOf(AuthenticationState);

        var items = new List<DashboardItem>();

        foreach (var contributor in Contributors)
        {
            items.AddRange(await contributor.GetItems(subject));
        }

        _items = await NsDashboard.Allowed(items, Gate, user);
        _resolvedFor = subject;
        _resolved = true;
    }

    Dictionary<string, object> GetParameters(DashboardItem item)
    {
        return new Dictionary<string, object>
        {
            ["Icon"] = item.Icon!,
            ["Subject"] = Subject!
        };
    }
}
