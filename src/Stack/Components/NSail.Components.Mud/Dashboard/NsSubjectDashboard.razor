@namespace NSail.Components
@typeparam TSubject

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IEnumerable<IDashboardContributor<TSubject>> Contributors
@inject PageGate Gate

@if (_items.Count > 0)
{
    @* Same owner-of-the-scroll declaration NsDashboard makes, for the same reason: the grid
       is a stretched flex item wherever it is hosted, and a stretched grid sizes its auto
       rows against the height it was handed instead of the height its cards need. *@
    <NsStack Grow Scroll>
        <div class="ns-dashboard">
            @foreach (var item in _items)
            {
                <DynamicComponent @key="item.CardType" Type="item.CardType!" Parameters="@GetParameters(item)" />
            }
        </div>
    </NsStack>
}

@code {

    IReadOnlyList<DashboardItem> _items = [];

    /// <summary>What every card on this dashboard is about. Contributors are resolved closed
    /// over its type, so a subject dashboard never collects another one's cards.</summary>
    [Parameter]
    public TSubject? Subject { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Subject is null)
        {
            _items = [];
            return;
        }

        var user = AuthenticationState is null
            ? new ClaimsPrincipal(new ClaimsIdentity())
            : (await AuthenticationState).User;

        var items = new List<DashboardItem>();

        foreach (var contributor in Contributors)
        {
            items.AddRange(await contributor.GetItems(Subject));
        }

        _items = await NsDashboard.Allowed(items, Gate, user);
    }

    Dictionary<string, object> GetParameters(DashboardItem item)
    {
        return new Dictionary<string, object>
        {
            ["Icon"] = item.Icon!,
            ["Subject"] = Subject!
        };
    }
}
