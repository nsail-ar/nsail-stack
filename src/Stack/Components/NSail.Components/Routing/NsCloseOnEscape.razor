@namespace NSail.Components
@using Microsoft.AspNetCore.Components.Web

@* Escape is how every overlay in the world is dismissed, and a routed surface had no key
   handling at all. The wrapper is focusable and takes focus once, because the click that
   opened the surface left focus on the link that opened it — a handler on an element
   nothing inside has focused never sees the key. Closing goes through Surface.Close(), so
   the unsaved-changes guard answers exactly as it does for the X. *@
<div class="@Class" tabindex="-1" @ref="_element" @onkeydown="OnKeyDown">
    @ChildContent
</div>

@code {

    ElementReference _element;

    [CascadingParameter]
    SurfaceContext? Surface { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>What Escape closes where it is not the surface this wrapper stands in — the
    /// layout's companion region, which has no route and so no <c>Surface.Close()</c> to reach.
    /// Named, never derived: the surface around such a region is the MAIN one, and Escape on a
    /// page is not "leave the app".</summary>
    [Parameter]
    public EventCallback Closes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether taking focus on mount is this wrapper's to do — true for a routed
    /// surface, which a door's click always opened, and left false only by the companion
    /// region, whose own open can equally be a silent recall. <see cref="Owns"/> still claims
    /// Escape regardless, for whenever a click inside hands this element the focus the recall
    /// did not take.</summary>
    [Parameter]
    public bool Focuses { get; set; } = true;

    bool Owns => Closes.HasDelegate || Surface is { IsMain: false };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Owns && Focuses)
        {
            await _element.FocusAsync();
        }
    }

    async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !Owns)
        {
            return;
        }

        if (Closes.HasDelegate)
        {
            await Closes.InvokeAsync();

            return;
        }

        Surface!.Close();
    }
}
