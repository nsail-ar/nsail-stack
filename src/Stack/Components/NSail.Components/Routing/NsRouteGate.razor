@namespace NSail.Components

@inherits NsComponent

@inject IEnumerable<IRouteGate> Gates
@inject NavigationManager Navigation

@* Nothing renders until every gate has answered: a route drawn while the question is in
   flight is a route that was never gated, and on the redirect path the user would see the
   page they are not allowed to have before it goes away. *@
@if (_allowed)
{
    @ChildContent
}

@code {

    bool _allowed;

    Type? _asked;

    [Parameter, EditorRequired]
    public Type PageType { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    RouteTable? Routes { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_asked == PageType)
        {
            return;
        }

        _asked = PageType;
        _allowed = false;

        // The lightest gate that answers is the one the visitor obeys (IRouteGate), and its
        // answer for the page it was asked about is a claim — they stay. Nothing lighter is
        // asked either way, and that is what stops the bouncing: a gate free to move the
        // visitor off the screen the deciding gate holds them on would send them back and
        // forth between two closed gates forever. Which gate decides is Weight's to say, not
        // the order somebody's composition root happened to register in.
        foreach (var gate in Gates.OrderBy(gate => gate.Weight))
        {
            if (await gate.GetRedirect(PageType) is not { } destination)
            {
                continue;
            }

            if (destination != PageType && Routes is not null)
            {
                Navigation.NavigateTo(Routes.GetUrl(destination), replace: true);

                return;
            }

            break;
        }

        _allowed = true;
    }
}
