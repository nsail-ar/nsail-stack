@namespace NSail.Components

@inject IJSRuntime JS

@* Draws nothing. Blazor's own FocusOnNavigate calls a plain selector the instant a navigation
   lands — a comma list ("[data-ns-arrival-focus], h1") is not that selector, because
   querySelector answers the first match in DOCUMENT ORDER and the screen's own name always
   comes before whatever a screen marks. ns.js (arrivalFocus) checks the marker on its own first
   and reaches for the fallback only when there is none — waiting for it, since a list's own
   search can still be behind a read in flight the instant this fires. *@

@code {

    RouteData? _last;
    bool _pending;

    [Parameter]
    public RouteData? RouteData { get; set; }

    /// <summary>What the router focuses when the arriving page carries no marker — a read-only
    /// page, a dashboard. "h1" so a screen reader still hears the page's title: the screen's own
    /// title row draws that heading, focusable (NsTitleBar, ui/focus.md).</summary>
    [Parameter]
    public string FallbackSelector { get; set; } = "h1";

    // RouteData is a fresh instance per navigation (Blazor's Router.Refresh) and the same
    // instance across a render the page caused for its own reasons — StateHasChanged moves no
    // route — so comparing the reference, not the page type or the route values, is what makes
    // this fire once per arrival and never on a re-render.
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(RouteData, _last))
        {
            _last = RouteData;
            _pending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pending)
        {
            return;
        }

        _pending = false;

        await JS.InvokeVoidAsync("nsapp.arrivalFocus", FallbackSelector);
    }
}
