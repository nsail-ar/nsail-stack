#nullable enable

﻿using Microsoft.Extensions.DependencyInjection;

namespace {{ Namespace }}
{
    {{ ClassDeclaration }}
    {
        {{ MethodDeclaration }}
        {
            {{~ for Service in Injectables ~}}
            {{~ if Service.AliasType != null ~}}
            {{ ServicesParameterName }}.Add{{ Service.Lifetime }}<{{ Service.ServiceType }}>(sp => sp.GetRequiredService<{{ Service.AliasType }}>());
            {{~ else if Service.ImplementationType != null ~}}
            {{ ServicesParameterName }}.Add{{ Service.Lifetime }}<{{ Service.ServiceType }}, {{ Service.ImplementationType }}>();
            {{~ else ~}}
            {{ ServicesParameterName }}.Add{{ Service.Lifetime }}<{{ Service.ServiceType }}>();
            {{~ end ~}}  
            {{~ end ~}}
        }
    }
}