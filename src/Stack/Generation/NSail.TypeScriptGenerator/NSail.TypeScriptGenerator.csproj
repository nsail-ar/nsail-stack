<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>NSail.TypeScriptGenerator</RootNamespace>
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<!-- A build-time tool, packed as one: the published tool and every assembly it loads under
	     tools/, the targets that run it under build/ (NuGet imports them for the consumer), and
	     nothing a consumer compiles against — no lib/, no dependencies to flow. -->
	<PropertyGroup>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<DevelopmentDependency>true</DevelopmentDependency>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTool</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<None Update="build/NSail.TypeScriptGenerator.targets" Pack="true" PackagePath="build/NSail.TypeScriptGenerator.targets" />
	</ItemGroup>

	<Target Name="PackTool" DependsOnTargets="Publish">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(PublishDir)**/*" PackagePath="tools/$(TargetFramework)/any/%(RecursiveDir)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<InternalsVisibleTo Include="NSail.TypeScriptGenerator.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The C# generator's own model: which messages a client sends and where each member
		     binds come from HttpModelFactory, so the TypeScript client and the C# one are two
		     renderings of one reading. -->
		<ProjectReference Include="..\NSail.SourceGenerator\NSail.SourceGenerator.csproj" />
		<ProjectReference Include="..\..\Metadata\NSail.Metadata\NSail.Metadata.csproj" />
		<!-- Loaded so a Stack validation attribute that subclasses a BCL one ([SearchTerm]) can be
		     constructed and read like the BCL rule it is. -->
		<ProjectReference Include="..\..\Messaging\NSail.Messaging.Runtime\NSail.Messaging.Runtime.csproj" />
	</ItemGroup>

</Project>
