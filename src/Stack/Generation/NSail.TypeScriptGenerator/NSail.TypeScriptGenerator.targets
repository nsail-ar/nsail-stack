<Project>

	<!-- Imported by an Sdk inside this repository: the tool runs from its own build output, built
	     first through the reference below. An Sdk outside it takes the package instead, whose
	     build/ file is the one imported here.

	     <PropertyGroup><TypeScriptOutput>…/src/sdk.ts</TypeScriptOutput></PropertyGroup>
	     <Import Project="…/NSail.TypeScriptGenerator/NSail.TypeScriptGenerator.targets" /> -->

	<PropertyGroup>
		<_TypeScriptTool>$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/NSail.TypeScriptGenerator.dll</_TypeScriptTool>
	</PropertyGroup>

	<ItemGroup Condition="'$(TypeScriptOutput)' != ''">
		<ProjectReference Include="$(MSBuildThisFileDirectory)NSail.TypeScriptGenerator.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<Import Project="build/NSail.TypeScriptGenerator.targets" />

</Project>
