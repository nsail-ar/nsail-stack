<Project>

	<!-- Imported by an Sdk that ships a TypeScript client, the twin of its [Generated(Http.Clients)]
	     holder: after the Sdk compiles, its own sources and references are handed to the tool,
	     which reads them with the C# generator's model and writes $(TypeScriptOutput).

	     <PropertyGroup><TypeScriptOutput>…/src/sdk.ts</TypeScriptOutput></PropertyGroup>
	     <Import Project="…/NSail.TypeScriptGenerator/NSail.TypeScriptGenerator.targets" /> -->

	<PropertyGroup>
		<_TypeScriptTool>$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/NSail.TypeScriptGenerator.dll</_TypeScriptTool>
	</PropertyGroup>

	<ItemGroup Condition="'$(TypeScriptOutput)' != ''">
		<ProjectReference Include="$(MSBuildThisFileDirectory)NSail.TypeScriptGenerator.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<Target Name="GenerateTypeScript"
	        AfterTargets="CoreCompile"
	        Condition="'$(TypeScriptOutput)' != ''"
	        Inputs="@(Compile);@(ReferencePath);$(MSBuildProjectFullPath);$(_TypeScriptTool)"
	        Outputs="$(TypeScriptOutput)">
		<PropertyGroup>
			<_TypeScriptArguments>$(IntermediateOutputPath)typescript.rsp</_TypeScriptArguments>
		</PropertyGroup>
		<ItemGroup>
			<_TypeScriptDefine Include="$(DefineConstants)" />
			<_TypeScriptLine Include="assembly=$(AssemblyName)" />
			<_TypeScriptLine Include="out=$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(TypeScriptOutput)'))" />
			<_TypeScriptLine Include="@(Compile->'source=%(FullPath)')" />
			<_TypeScriptLine Include="@(ReferencePath->'reference=%(FullPath)')" />
			<_TypeScriptLine Include="@(_TypeScriptDefine->'define=%(Identity)')" />
		</ItemGroup>
		<WriteLinesToFile File="$(_TypeScriptArguments)" Lines="@(_TypeScriptLine)" Overwrite="true" />
		<Exec Command="dotnet &quot;$(_TypeScriptTool)&quot; &quot;@$(_TypeScriptArguments)&quot;" />
		<!-- The tool leaves an unchanged file untouched; touching it keeps the target incremental. -->
		<Touch Files="$(TypeScriptOutput)" />
	</Target>

</Project>
