<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NSail.Harness.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The build-turn doorman every lane finds first on its PATH, beside the host's binary: a
       package carries it as content its consumer copies to its own output. A package keeps no
       file mode, so a host's install marks them executable. -->
  <ItemGroup>
    <None Include="shims/**" CopyToOutputDirectory="PreserveNewest" LinkBase="shims"
          Pack="true" PackagePath="contentFiles/any/any/shims" PackageCopyToOutput="true" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <ProjectReference Include="../../Telemetry/NSail.Telemetry/NSail.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NSail.Harness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NSail.Harness\NSail.Harness.csproj" />
  </ItemGroup>

</Project>
