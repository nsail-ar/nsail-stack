#!/usr/bin/env bash
# The doorman of a machine's build turns, put first on a lane's PATH by the harness.
# A `dotnet build|test|publish|restore|pack|msbuild|ef` waits for a turn from the harness
# (served by priority, not arrival) before it runs and gives it back when it ends, so however
# many lanes sail, only a few compile at once. A `dotnet run|watch` builds under a turn first and
# gives it back before the app starts, so an app that serves for hours holds none. Anything else
# goes straight through. The same script serves Git Bash on Windows and bash on Linux and macOS.
set -u

real="${HARNESS_REAL_DOTNET:-}"
if [ -z "$real" ]; then
  here="$(cd "$(dirname "$0")" && pwd)"
  real="$(PATH="${PATH//$here:/}" command -v dotnet || true)"
fi
[ -n "$real" ] || { echo "harness: no dotnet on the PATH" >&2; exit 127; }

case "${1:-}" in
  build|test|publish|restore|pack|msbuild|ef|run|watch) ;;
  *) exec "$real" "$@" ;;
esac

# MSBuild starts a node per core, and a test run a host per project at once: two builds on a
# sixteen-core box were thirty-odd processes. A lane's build gets HARNESS_BUILD_NODES of them,
# unless the command names its own.
nodes() {
  case " $* " in
    *" -m"*|*" -maxcpucount"*|*" /m"*|*" -- "*) ;;
    *) [ -n "${HARNESS_BUILD_NODES:-}" ] && printf '%s' "-maxcpucount:$HARNESS_BUILD_NODES" ;;
  esac
}

case "$1" in
  build|test|publish|pack|msbuild) width="$(nodes "$@")"; set -- "$@" ${width:+"$width"} ;;
esac

# A dotnet started under a held turn (an E2E fixture publishing its host) rides it; with no harness
# there is no turn to wait for.
if [ -z "${HARNESS_URL:-}" ] || [ -n "${HARNESS_LEASE_HELD:-}" ]; then
  exec "$real" "$@"
fi
ORIGINAL=("$@")

lease=""
take() {
  local asked waited
  asked=$(date +%s)
  # The answer is the lease id as a JSON string.
  lease="$(curl -fsS --max-time 7200 -X POST -H "Content-Type: application/json" -H "X-Harness-Token: ${HARNESS_LEASE_TOKEN:-}" \
    -d"{\"holder\":\"${HARNESS_HOLDER:-lane}\",\"rank\":${HARNESS_RANK:-9}}" "$HARNESS_URL/api/harness/leases" 2>/dev/null)" || {
    echo "harness: the harness gave no build turn (${HARNESS_URL}) — running without one" >&2
    lease=""
    return 1
  }
  waited=$(( $(date +%s) - asked ))
  lease="${lease//\"/}"
  [ "$waited" -ge 10 ] && echo "harness: waited ${waited}s for a build turn (other builds held the machine's turns)" >&2
  return 0
}

give() {
  [ -n "$lease" ] || return 0
  curl -fsS -X DELETE -H "X-Harness-Token: ${HARNESS_LEASE_TOKEN:-}" "$HARNESS_URL/api/harness/leases/$lease" >/dev/null 2>&1 || true
  lease=""
}

if [ "$1" = run ] || [ "$1" = watch ]; then
  # What `dotnet build` needs of a run's or a watch's own options: the project and the build's
  # settings. The app's (a launch profile, an environment, what follows `--`) stay with the app.
  verb="$1"
  build=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --) break ;;
      --no-build) exec "$real" "${ORIGINAL[@]}" ;;
      --project|-p|--file) [ $# -gt 1 ] && { build+=("$2"); shift; } ;;
      --project=*) build+=("${1#--project=}") ;;
      -c|--configuration|-f|--framework|-r|--runtime|-a|--arch|--os) [ $# -gt 1 ] && { build+=("$1" "$2"); shift; } ;;
      # A watch's -v is a switch (verbose); a run's takes a level.
      -v|--verbosity) [ "$verb" = run ] && [ $# -gt 1 ] && { build+=("$1" "$2"); shift; } ;;
      --launch-profile|-lp|-e|--environment) shift ;;
      -p:*|/p:*|-property:*|--property:*|--configuration=*|--framework=*|--runtime=*|--arch=*|--os=*) build+=("$1") ;;
      --no-restore|--no-dependencies|--self-contained|--no-self-contained|--sc|--ucr|--use-current-runtime|--disable-build-servers|--interactive) build+=("$1") ;;
      *.cs|*.csproj|*.fsproj|*.vbproj|*.sln|*.slnx) build+=("$1") ;;
    esac
    shift
  done
  width="$(nodes ${build[@]+"${build[@]}"})"
  if take; then
    HARNESS_LEASE_HELD=1 "$real" build ${build[@]+"${build[@]}"} ${width:+"$width"}
    built=$?
    give
  else
    "$real" build ${build[@]+"${build[@]}"} ${width:+"$width"}
    built=$?
  fi
  [ "$built" -eq 0 ] || exit "$built"
  # Built under the turn: the app starts holding none, and a run does not build again.
  [ "$verb" = run ] && exec "$real" run --no-build "${ORIGINAL[@]:1}"
  exec "$real" "${ORIGINAL[@]}"
fi

take || exec "$real" "$@"
trap give EXIT
trap 'exit 130' INT TERM

# A dotnet this one starts (an E2E fixture publishing its host) rides the turn already held.
export HARNESS_LEASE_HELD=1
"$real" "$@"
exit $?
